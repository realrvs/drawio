        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Use Case: Модуль Экспертизы\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF\n  BorderColor black\n  ArrowColor gray\n}\nskinparam note {\n  BackgroundColor #FDFDFD\n  BorderColor #CCC\n  FontColor #666\n}\n\nactor \&quot;Секретарь ЗК\&quot; as Secretary\nactor \&quot;Куратор ЭГ\&quot; as Curator\nactor \&quot;Эксперт (Член ЭГ)\&quot; as Expert\nactor \&quot;Участник закупки\&quot; as Bidder\nactor \&quot;Руководитель ДЗ\&quot; as HeadDZ\nactor \&quot;Начальник отдела закупок\&quot; as HeadDept\nactor \&quot;Начальник УПЗП\&quot; as HeadUPZP\n\n&#39; Внешние модули — объединённый блок\npackage \&quot;Вспомогательные модули\&quot; {\n  usecase \&quot;Передать критерии и требования\&quot; as UC_Ext1\n  note top of UC_Ext1\n    Модуль Планирование (ПЗД)\n  end note\n\n  usecase \&quot;Связать экспертизу с лотом\&quot; as UC_Ext2\n  note top of UC_Ext2\n    Модуль Закупки / Лот\n  end note\n\n  usecase \&quot;Предоставить шаблоны и справочники\&quot; as UC_Ext3\n  note top of UC_Ext3\n    Модуль Справочники / Шаблоны\n  end note\n\n  usecase \&quot;Обновить состав ЭГ\&quot; as UC_Ext4\n  note top of UC_Ext4\n    Модуль Реестр экспертов\n  end note\n\n  usecase \&quot;Принять решение по закупке\&quot; as UC_Ext5\n  note bottom of UC_Ext5\n    Модуль Конструктор ЗК\n  end note\n}\n\n&#39; Основной модуль\npackage \&quot;Модуль Экспертиза\&quot; {\n  package \&quot;Работа с ИЭЗ\&quot; {\n    usecase \&quot;Назначить экспертов по направлениям\&quot; as UC1\n    usecase \&quot;Создать ИЭЗ\&quot; as UC2\n    usecase \&quot;Заполнить ИЭЗ\&quot; as UC3\n    usecase \&quot;Отправить ИЭЗ на проверку\&quot; as UC4\n    usecase \&quot;Проверить ИЭЗ\&quot; as UC5\n  }\n  package \&quot;Работа с СЭЗ\&quot; {\n    usecase \&quot;Создать СЭЗ\&quot; as UC6\n    usecase \&quot;Согласовать СЭЗ\&quot; as UC7\n  }\n  package \&quot;Работа с дозапросами\&quot; {\n    usecase \&quot;Создать дозапрос\&quot; as UC9\n    usecase \&quot;Отправить дозапрос на согласование\&quot; as UC11\n    usecase \&quot;Согласовать дозапрос\&quot; as UC12\n    usecase \&quot;Провести доп. экспертизу\&quot; as UC10\n  }\n}\n\n&#39; Связи акторов\nSecretary --&gt; UC1\nSecretary --&gt; UC6\nSecretary --&gt; UC9\nSecretary --&gt; UC11\n\nCurator --&gt; UC1\nCurator --&gt; UC5\nCurator --&gt; UC6\nCurator --&gt; UC7\n\nExpert --&gt; UC2\nExpert --&gt; UC3\nExpert --&gt; UC4\nExpert --&gt; UC10\n\nBidder --&gt; UC9\nBidder --&gt; UC10\n\nHeadDZ --&gt; UC11\nHeadDZ --&gt; UC12\nHeadDept --&gt; UC11\nHeadDept --&gt; UC12\nHeadUPZP --&gt; UC12\n\n&#39; Взаимодействие между модулями\nUC_Ext1 --&gt; UC2\nUC_Ext2 --&gt; UC1\nUC2 --&gt; UC_Ext3\nUC1 --&gt; UC_Ext4\nUC6 --&gt; UC_Ext5 : Согласованный СЭЗ\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--148">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="1160" y="1810" width="1024" height="1107" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Use Case: Модуль Реестр экспертов\n&#39; Use Case: Работа с экспертами и их реестром\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF\n  BorderColor black\n  ArrowColor gray\n}\n\nactor \&quot;Секретарь ЗК\&quot; as Secretary\nactor \&quot;Куратор ЭГ\&quot; as Curator\nactor \&quot;Руководитель ДЗ\&quot; as HeadDZ\nactor \&quot;Начальник отдела закупок\&quot; as HeadDept\nactor \&quot;Начальник УПЗП\&quot; as HeadUPZP\n\n&#39; Блок назначения и замены экспертов\npackage \&quot;Модуль Экспертиза: Работа с ЭГ\&quot; {\n  usecase \&quot;Назначить куратора ЭГ\&quot; as UC1\n  usecase \&quot;Назначить члена ЭГ\&quot; as UC2\n  usecase \&quot;Создать карточку замены эксперта\&quot; as UC3\n  usecase \&quot;Согласовать замену эксперта\&quot; as UC4\n}\n\n&#39; Блок управления экспертами и справочниками\npackage \&quot;Модуль Реестр экспертов\&quot; {\n  usecase \&quot;Включить эксперта в реестр\&quot; as UC5\n  usecase \&quot;Изменить сведения об эксперте\&quot; as UC6\n  usecase \&quot;Исключить эксперта из реестра\&quot; as UC7\n  usecase \&quot;Просмотреть реестр экспертов\&quot; as UC8\n  usecase \&quot;Ведение справочника экспертов\&quot; as UC9\n}\n\n&#39; Связи акторов с действиями\nSecretary --&gt; UC1\nSecretary --&gt; UC2\nSecretary --&gt; UC3\n\nCurator --&gt; UC3\n\nHeadDZ --&gt; UC4\nHeadDZ --&gt; UC5\nHeadDZ --&gt; UC6\nHeadDZ --&gt; UC7\nHeadDZ --&gt; UC8\nHeadDZ --&gt; UC9\n\nHeadDept --&gt; UC4\nHeadDept --&gt; UC5\nHeadDept --&gt; UC6\nHeadDept --&gt; UC7\nHeadDept --&gt; UC8\nHeadDept --&gt; UC9\n\nHeadUPZP --&gt; UC4\n\n&#39; Взаимосвязи между use case\nUC3 --&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC4 --&gt; UC2 : Назначение нового члена ЭГ\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--149">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="2260" y="1810" width="1181" height="876" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Use Case: Модуль критерии и требования\n&#39; Use Case: Работа с критериями и требованиями\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF\n  BorderColor black\n  ArrowColor gray\n}\n\nactor \&quot;Куратор ПО\&quot; as CuratorPO\nactor \&quot;Директор ПО\&quot; as DirectorPO\nactor \&quot;Администратор справочников\&quot; as Admin\nactor \&quot;Эксперт\&quot; as Expert\n\n&#39; Модуль 1: Планирование\npackage \&quot;Планирование (ПЗД)\&quot; {\n  usecase \&quot;Определить требования к участникам\&quot; as UC1\n  usecase \&quot;Задать критерии оценки\&quot; as UC2\n  usecase \&quot;Настроить веса и методы оценки\&quot; as UC3\n  usecase \&quot;Привязать критерии к направлениям\&quot; as UC4\n}\n\n&#39; Модуль 2: Справочники\npackage \&quot;Справочники и шаблоны\&quot; {\n  usecase \&quot;Управлять шаблонами\\nкритериев, направлений и ролей\&quot; as UC0\n}\n\n&#39; Модуль 3: Экспертиза\npackage \&quot;Экспертиза (ИЭЗ)\&quot; {\n  usecase \&quot;Работать с критериями в ИЭЗ\&quot; as UC5\n  usecase \&quot;Работать с требованиями в ИЭЗ\&quot; as UC6\n}\n\n&#39; Роли и связи\nCuratorPO --&gt; UC1\nCuratorPO --&gt; UC2\nDirectorPO --&gt; UC1\nDirectorPO --&gt; UC2\n\nAdmin --&gt; UC3\nAdmin --&gt; UC4\nAdmin --&gt; UC0\n\nExpert --&gt; UC5\nExpert --&gt; UC6\n\n&#39; Взаимосвязи между модулями\nUC0 --&gt; UC2 : &lt;&lt;использует шаблоны&gt;&gt;\nUC0 --&gt; UC4 : &lt;&lt;использует направления и роли&gt;&gt;\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--150">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="3520" y="1800" width="1081" height="731" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Установление требований к участникам\n\nstart\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Открытие ПЗД;\n  :Переход на вкладку \&quot;Критерии\&quot; в БО \&quot;ПЗД\&quot; (подвкладка \&quot;Оценка\&quot;);\n  :Добавление требований к участникам вручную или из шаблонов;\n  :Указание обязательности и параметров требований;\n}\n\n:Требования определены;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--151">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="1154" y="2980" width="434" height="420" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Настройка критериев оценки\n\nstart\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Открытие ПЗД;\n  :Переход на вкладку \&quot;Критерии\&quot; в БО \&quot;ПЗД\&quot; (подвкладка \&quot;Оценка\&quot;);\n  :Создание критерия вручную или добавление из справочника;\n  :Настройка параметров критерия (метод, вес, значения и описание);\n  :Удаление или редактирование критериев (при необходимости);\n}\n\n:Критерии оценки определены;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--152">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="1600" y="2980" width="440" height="473" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Формирование экспертной группы \n\nstart\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Открытие ПЗД;\n  :Переход на вкладку \&quot;Лоты ПЗД\&quot;;\n  :Нажатие \&quot;Редактировать\&quot; в подстрочном меню лота;\n  :Переход на вкладку \&quot;Экспертная группа\&quot; в БО \&quot;Лот ПЗД\&quot;;\n  :Добавление Куратора ЭГ;\n  :Добавление Членов ЭГ (повторяется при необходимости);\n}\n\n:Состав экспертной группы сформирован;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--153">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="2060" y="2980" width="380" height="525" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Создание и заполнение ИЭЗ \n\nstart\n\npartition \&quot;Система АИСУЗ\&quot; {\n  :Создание ИЭЗ системой на основании ПЗД и состава ЭГ;\n  :Уведомление эксперта о назначении ИЭЗ;\n}\n\npartition \&quot;Эксперт\&quot; {\n  :Открытие экспертом ИЭЗ;\n  :Загрузка заявления о конфиденциальности и беспристрастности;\n  :Нажатие кнопки \&quot;Приступить к работе\&quot;;\n  :Заполнение вкладки \&quot;Основные данные\&quot; (срок подготовки);\n  :Ознакомление с документацией и предложениями участников;\n  :Формирование замечаний (при необходимости);\n  :Оценка предложений по критериям;\n  :Сохранение данных ИЭЗ;\n  :Отправка ИЭЗ на проверку;\n}\n\n:ИЭЗ сформировано и отправлено на проверку;\n\nstop\n\nnote right\nИЭЗ создаются после создания СЭЗ\nend note\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--154">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="2460" y="2980" width="480" height="829" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Проверка ИЭЗ куратором ЭГ \n\nstart\n\npartition \&quot;Куратор ЭГ\&quot; {\n  :Получение уведомления о готовности ИЭЗ;\n  :Открытие ИЭЗ\n(через реестр ИЭЗ, вкладка \&quot;На проверке\&quot;\nили \&quot;Поступившие на согласование\&quot;,\nкнопка \&quot;Просмотр\&quot;);\n  :Ознакомление с содержимым и результатами оценки\n(предложения участников,\nзамечания экспертов, оценочную стадию,\nдокументы);\n  :Проверка содержимого загруженного заявления эксперта;\n  :Проверка полноты и корректности разделов ИЭЗ\n(обязательные поля, документы, \nзавершенность стадий,\nинициируется кнопками \&quot;Проверка\&quot; или \&quot;Выполнить\&quot;);\n  :Добавление комментариев и замечаний (при необходимости);\n\n  if (Решение куратора?) then ([Отклонить])\n    :Изменение статуса ИЭЗ\nна \&quot;На доработке исполнителем\&quot;;\n  note left\n  Возврат к процессу \&quot;Создание и заполнение ИЭЗ \&quot;\n  end note\n  else ([Проверить/Подтвердить])\n    :Изменение статуса ИЭЗ на \&quot;Проверено\&quot;;\n  endif\n\n  :Завершение проверки ИЭЗ;\n}\n\n\n:ИЭЗ проверено;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--155">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="2980" y="2980" width="848" height="824" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="gikS4-EkkRHcnsDqJiC--156" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="2780" y="2090" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gikS4-EkkRHcnsDqJiC--157" value="В файле с ролями было написано, что согласовать замену эксперта могут эти роли, но в РП про это явно не прописано" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="3060" y="2140" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gikS4-EkkRHcnsDqJiC--158" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Про роли&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Оставила пока тут только Секретарь ЗК, но в Use Case диаграммах отразила, что это могут делать и другие роли. Мне кажется тут РП и документ с ролями и функциями немного отличается&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="950" y="3063" width="180" height="217" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Формирование и согласование СЭЗ\n\nstart\n\npartition \&quot;Секретарь ЗК / Куратор ЭГ\&quot; {\n  :Создание СЭЗ;\n  note right\n  Выполняется Секретарем ЗК или Куратором ЭГ через вкладку\n  \&quot;Экспертиза\&quot; → \&quot;СЭЗ\&quot; в реестре закупок.\n  end note\n}\n\npartition \&quot;Система АИСУЗ\&quot; {\n  :Автоматическое создание ИЭЗ для членов ЭГ;\n}\n\npartition \&quot;Члены ЭГ\&quot; {\n  :Работа Членов ЭГ над ИЭЗ и достижение ИЭЗ статуса \&quot;Проверено\&quot;;\n}\n\npartition \&quot;Куратор ЭГ\&quot; {\n  :Проверка полноты и корректности включённых ИЭЗ;\n  note right\n  Проверка и заполнение СЭЗ выполняются Куратором ЭГ после завершения всех ИЭЗ.\n  end note\n\n  :Формирование СЭЗ (заполнение основной информации);\n  note right\n  Включает добавление файла \&quot;Сводное экспертное заключение\&quot;.\n  end note\n\n  :Сохранение и отправка СЭЗ на согласование;\n  note right\n  Выполняется Куратором ЭГ через кнопку \&quot;Отправить на согласование\&quot;.\n  end note\n}\n\npartition \&quot;Согласующий (\&quot;Секретарь ЗК / Куратор ЭГ)\&quot; {\n  if (Решение по СЭЗ) then ([Отклонить])\n    :Возврат СЭЗ на доработку Куратору ЭГ;\n    partition \&quot;Куратор ЭГ\&quot; {\n      :Внесение корректировок в СЭЗ Куратором ЭГ;\n      --&gt; :Сохранение и отправка СЭЗ на согласование;\n    }\n  else ([Согласовать])\n    :Изменение статуса СЭЗ на \&quot;Согласовано\&quot;;\n  endif\n}\n:СЭЗ согласовано (если требуются дозапросы -&gt; процесс Дозапросы и доп. экспертиза);\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="GNQkYQP_EVua9S_DZI-Y-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="3850" y="2980" width="1042" height="938" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Дозапросы и доп. экспертиза\nstart\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Создание СЭЗ;\n}\n\npartition \&quot;Куратор ЭГ\&quot; {\n  :Работа с СЭЗ;\n  :Отметка замечаний как \&quot;Рекомендуется дозапрос\&quot;;\n}\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Создание карточки дозапроса;\n  :Заполнение поля «Текст дозапроса»;\n  :Отправка дозапроса на согласование;\n}\n\nrepeat\n  partition \&quot;Куратор ЭГ / Начальник ЭГ (Согласующие)\&quot; {\n    :Рассмотрение и согласование дозапроса;\n  }\n\n  if (Дозапрос согласован?) then (Да)\n    break\n  else (Нет)\n    partition \&quot;Секретарь ЗК\&quot; {\n      :Дозапрос возвращён Секретарю ЗК;\n      :Корректировка карточки;\n      :Повторная отправка дозапроса;\n    }\n  endif\nrepeat while (Не согласован)\n\npartition \&quot;Секретарь ЗК\&quot; {\n  :Отправка дозапроса участнику;\n  :Получение ответа участника;\n  :Инициация дополнительной экспертизы;\n}\n\npartition \&quot;Член ЭГ\&quot; {\n  :Анализ полученных материалов;\n  :Дополнение ИЭЗ (при необходимости);\n}\n\npartition \&quot;Куратор ЭГ\&quot; {\n  :Проверка ИЭЗ;\n  :Финализация СЭЗ;\n}\n\n:Дозапрос доработан и ИЭЗ и СЭЗ обновлены;\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="GlwZbsTEna0PSS5sDHr8-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="4920" y="2980" width="399" height="1542" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity: Замена эксперта \n\nstart\n\npartition \&quot;Инициатор (Секретарь ЗК / Куратор ЭГ)\&quot; {\n  :Создание карточки замены эксперта;\n  :Выбор типа замены (Куратор / Член ЭГ);\n  :Указание заменяемого и заменяющего эксперта;\n  note right\n  Выбор ограничен: заменяемый — действующий эксперт с непроверенным ИЭЗ;\n  заменяющий — есть в реестре, не в составе текущей ЭГ.\n  end note\n  :Заполнение причины замены;\n  :Отправка карточки на согласование;\n  :Уведомление инициатора об отправке карточки на согласование;\n}\n\nrepeat\n  partition \&quot;Согласующий (Начальник куратора ЭГ)\&quot; {\n    :Рассмотрение заявки на замену;\n    note right\n    Согласующий может не только утвердить или отклонить,\n    но и изменить параметры замены.\n    end note\n  }\n  if (Заявка согласована?) then ([Да])\n    break\n  else ([Нет])\n    partition \&quot;Инициатор\&quot; {\n      :Карточка возвращена на доработку;\n      :Корректировка карточки замены;\n      :Повторная отправка на согласование;\n    }\n  endif\nrepeat while (Не согласована)\n\npartition \&quot;Согласующий (Начальник куратора ЭГ)\&quot; {\n  :Применение замены;\n  :Прикрепление файла \&quot;Основание для изменения\&quot;;\n}\n\npartition \&quot;Система АИСУЗ\&quot; {\n  :Уведомление заменяемого и заменяющего экспертов;\n  :Обновление состава ЭГ;\n  :Передача ИЭЗ заменяющему эксперту;\n}\n  :Состав ЭГ обноволен, ИЭЗ передано заменяющему эксперту;\n\nstop\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="GlwZbsTEna0PSS5sDHr8-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="5339" y="2980" width="864" height="1332" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GlwZbsTEna0PSS5sDHr8-3" value="TO DO: Добавление нового эксперта" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="1" vertex="1">
