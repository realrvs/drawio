        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|User|\nstart\n:Open \&quot;Реестр КЦД\&quot;;\n:Click \&quot;Показать фильтр\&quot;;\n\n:Enter text fields and select dropdowns;\nif (Need to pick Контрагент?) then (yes)\n    :Click \&quot;...\&quot; next to Контрагент;\n    |System|\n    :Show \&quot;Контрагенты\&quot; dialog;\n    |User|\n    :Select a Контрагент and click OK;\nendif\n\nif (Need to pick Способ закупки?) then (yes)\n    :Click \&quot;...\&quot; next to Способ закупки;\n    |System|\n    :Show \&quot;Способы закупки\&quot; dialog;\n    |User|\n    :Select a Способ закупки and click OK;\nendif\n\n:Click \&quot;Применить\&quot;;\n|System|\n:Filter records by criteria;\n:Display filtered results;\n|User|\n:View results;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-3">
