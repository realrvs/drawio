        <mxCell id="izdXQZAGnsvKLJ6Wg3wu-170" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;переговори с Дарьей - кто вносит в ПЗД Требования и Критерии?&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;(скорее: Куратог ЭГ и Отв.Исп. в ПО)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="izdXQZAGnsvKLJ6Wg3wu-168" vertex="1">
