        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml СистемаККСУ_Component\n\ncomponent \&quot;Система ведения Каталога\&quot; as Каталог {\n  component \&quot;Реестр Каталога\&quot;\n  component \&quot;Реестр проектов изменений\&quot;\n  component \&quot;Фильтры и поиск\&quot;\n  component \&quot;История изменений\&quot;\n  component \&quot;Реестр загруженных файлов\&quot;\n}\n\ncomponent \&quot;Справочники\&quot; as Справочники {\n  component \&quot;Классификация\&quot;\n  component \&quot;Классификация персонала\&quot;\n  component \&quot;Причины обращений в ЦЗК\&quot;\n  component \&quot;Статусы Проектов\&quot;\n  component \&quot;Подрядные Организации\&quot;\n  component \&quot;ОКПД2\&quot;\n  component \&quot;ОКТМО\&quot;\n} \n\ncomponent \&quot;Система работы с ЦЗК\&quot; as ЦЗКСистема {\n  component \&quot;Формирование вопросов\&quot;\n  component \&quot;Журнал согласований\&quot;\n}\n\nКаталог -- Справочники \nКаталог - ЦЗКСистема\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="PqC6RhTS1gyLuVYjz_Tp-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
