        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Пользователь\&quot; as User\n\npackage \&quot;Подсистема «Реестр КЦД»\&quot; {\n  usecase \&quot;Фильтрация реестра КЦД\\n(UC-12-01/1)\&quot; as UC1\n  usecase \&quot;Выбор контрагента\\n(UC-12-01/2)\&quot; as UC2\n  usecase \&quot;Выбор способа закупки\\n(UC-12-01/3)\&quot; as UC3\n}\n\nUser --&gt; UC1\nUser --&gt; UC2\nUser --&gt; UC3\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-5">
