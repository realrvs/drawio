          </mxCell>
        </UserObject>
        <mxCell id="PqC6RhTS1gyLuVYjz_Tp-2" value="Диаграмма Компонентов" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1" parent="1" vertex="1">
