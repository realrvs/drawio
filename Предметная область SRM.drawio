        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam style strictuml\n\nclass \&quot;Лот\&quot; {\n  +ID\n  +Номер лота\n  +Способ закупки\n  +Плановая сумма без НДС\n  +Плановая сумма с НДС\n  +Статус\n}\n\nclass \&quot;Потребности\&quot; {\n  +ID\n  +Номер потребности\n  +Связанная номенклатура\n  +Закупочная номенклатура\n+ОКПД2\n+Заказчик\n+Потребитель\n+ОКАТО\n+Срок поставки\n+Количество\n+ОКЕИ\n+Цена без НДС\n+Цена с НДС\n+Валюта\n+Статус\n+Ответственный\n+Дата создания\n+Заявка на закупку\n+Статус согласования заявки на закупку\n+Сгруппированная потребность\n+Лот планирования\n\n}\n\nclass \&quot;Заявки на закупку\&quot; {\n  +ID\n  +Номер заявки\n+Наименование\n  +Дата создания\n+Ответственный\n  +Статус согласования\n  +Потребители\n  +Заказчик\n+Кол-во потребностей: Всего/Уникальные\n+Планируемая стоимость заявки на закупку без учета НДС\n+Планируемая стоимость заявки на закупку с учетом НДС\n  +Файлы\n}\n\n\nclass \&quot;Сгруппированные потребности\&quot; {\n  +ID\n  +Номер\n+Закупочная номенклатура\n+ОКПД2\n+Заказчики\n+Кол-во включенных потребностей\n+ОКАТО\n+Срок поставки\n+Количество\n+ОКЕИ\n+Планируемая стоимость сгруппированной потребности без учета НДС\n+Планируемая стоимость сгруппированной потребности с учетом НДС\n+Ответственный за группировку\n+Статус\n+Номер лота планирования\n+Дата создания\n}\n\nclass \&quot;Файл/Вложение\&quot; {\n  +ID\n  +Тип файла\n  +Имя файла\n  +Версия\n  +Дата загрузки\n  +Автор\n}\n\nclass \&quot;Пользователь\&quot; {\n  +ID пользователя\n  +Ф И О\n  +Роль\n  +Организация\n}\n\nclass \&quot;Организация\&quot; {\n  +ID организации\n  +Наименование\n  +Тип\n}\n\nclass \&quot;Статус\&quot; {\n  +ID \n  +Наименование\n  +Тип Объекта\n}\n\nclass \&quot;Способ закупки\&quot; {\n  +ID \n  +Наименование\n}\n\nclass \&quot;Закупаемая продукция\&quot; {\n  +ID \n  +Лот\n  +О К П Д 2\n  +О К В Э Д 2\n  +Количество\n  +Единица измерения\n  +Минимально необходимые требования\n\n}\n\n\&quot;Потребности\&quot; o-- \&quot;Лот\&quot; : включает &gt;\n\&quot;Потребности\&quot; o-- \&quot;Заявки на закупку\&quot; : включается в &gt;\n\&quot;Сгруппированные потребности\&quot; o-- \&quot;Лот\&quot; : содержит &gt;\n\&quot;Сгруппированные потребности\&quot; o-- \&quot;Файл/Вложение\&quot; : включает &gt;\n\&quot;Потребности\&quot; o-- \&quot;Файл/Вложение\&quot; : содержит &gt;\n\&quot;Заявки на закупку\&quot; o-- \&quot;Файл/Вложение\&quot; : содержит &gt;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="eZXSJHuDc5mRW7gN6DIa-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="5160" y="55.5" width="1433" height="871" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml Планирование_потребностей\n\nleft to right direction\n\nactor \&quot;Ответственный за\\nформирование потребностей\&quot; as User1\nactor \&quot;Ответственный за\\nгруппировку\&quot; as User2\nactor \&quot;Ответственный за\\nлоты\&quot; as User3\nactor \&quot;Согласующий ЕИО\&quot; as Approver\nactor \&quot;ERP, ЕИС\&quot; as System\n\nrectangle \&quot;Планирование потребностей\&quot; {\n  usecase \&quot;1. Создать потребность\&quot; as UC1\n  usecase \&quot;2. Редактировать потребность\&quot; as UC2\n  usecase \&quot;3. Копировать потребность\&quot; as UC3\n  usecase \&quot;4. Удалить потребность\&quot; as UC4\n  \n  usecase \&quot;5. Создать заявку на закупку\&quot; as UC5\n  usecase \&quot;6. Отправить на согласование\&quot; as UC6\n  usecase \&quot;7. Согласовать/отклонить заявку\&quot; as UC7\n  \n  usecase \&quot;8. Создать сгруппированную потребность\&quot; as UC8\n  usecase \&quot;9. Изменить статус сгруппированной потребности\&quot; as UC9\n  \n  usecase \&quot;10. Создать лот планирования\&quot; as UC10\n  usecase \&quot;11. Добавить продукцию в лот\&quot; as UC11\n  usecase \&quot;12. Проверить правила (МСП, тип лота, способ закупки)\&quot; as UC12\n  \n  usecase \&quot;13. Загрузить номенклатуру из ERP\&quot; as UC13\n  usecase \&quot;14. Выгрузить данные в ЕИС\&quot; as UC14\n}\n\nUser1 --&gt; UC1\nUser1 --&gt; UC2\nUser1 --&gt; UC3\nUser1 --&gt; UC4\nUser1 --&gt; UC5\nUser1 --&gt; UC6\n\nApprover --&gt; UC7\n\nUser2 --&gt; UC8\nUser2 --&gt; UC9\n\nUser3 --&gt; UC10\nUser3 --&gt; UC11\nUser3 --&gt; UC12\n\nSystem --&gt; UC13\nSystem --&gt; UC14\n\n&#39; Связи между Use Cases\nUC5 .&gt; UC1 : Включает\nUC8 .&gt; UC1 : Агрегирует\nUC10 .&gt; UC8 : Использует\nUC11 .&gt; UC1 : Основано на\nUC12 .&gt; UC11 : Проверяет\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="-RK8GgsZLmwzwiCgSiOo-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="6616" y="39" width="734" height="1309" as="geometry" />
          </mxCell>
        </UserObject>
