        </mxCell>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml КаталогУслуг_Class_v2\n\nclass Каталог {\n  +НомерПозиции : Int\n  +НаименованиеПО : String\n  +Классификация : String\n  +ДатаИзменения : Date\n  +ОКПД2 : String\n  +КвалиффикацияПерсонала : String\n  +НаличиеМТР : String\n  +РазрешительнаяДокументация : String\n  +ОпытОказанияУслуг : String\n  +ДоляПривлеченияСубподряда : Int\n  +ПричинаОбращения : String\n  +ГергафическийПризнак : String\n  +ПротоколЦЗК : String\n  +ПереченьОбъектовГруппы : String\n}\n\nclass Классификация {\n  +Код : Int\n  +Наименование : String\n}\n\nclass КлассификацияПерсонала {\n  +Код : Int\n  +Наименование : String\n}\n\nclass ОКПД2 {\n  +Код : Int\n  +Наименование : String\n}\n\nclass ПО {\n  +КодОрганизации : Int\n  +Наименование : String\n  +КраткоеНаименование : String\n  +ИНН : Int\n  +КПП : Int\n  +ОГРН : Int\n}\n\nclass РеестрПроектов {\n  +НомерПроекта : Int\n  +НаименованиеПроекта : String\n  +ПротоколЦЗК : String\n  +Файл : Binary\n  +СтатусПроекта : String\n}\n\nclass СтатусПроекта {\n  +КодСтатуса : Int\n  +Наименование : String\n}\n\nclass ЗаявкаНаИзменение {\n  +НомерЗаявки : Int\n  +ДатаСоздания : Date\n  +ТипИзменения : String\n}\n\nclass ПричинаОбращения {\n  +КодПричины : Int\n  +Описание : String\n}\n\nclass ПроектИзменений {\n  +Номер : Int\n  +ДатаСоздания : Date\n  +Наименование : String\n  +Классификация : String\n  +ПО : String\n  +КвалификацияПерсонала : String\n  +ОпытОказанияУслуг : String\n  +ДоляПривлеченияСубподряда : String\n  +ОбоснованиеВнесенияИзменений : String\n  +ОбоснованиеПривлеченияСубподрядаБолее25% : String\n  +ПричинаОбращения : String\n  +ГеографическийПризнак : String\n  +ПереченьОбъектовГруппы : String\n}\n\nclass Позиция {\n  +Код : Int\n  +ТипИзменения : Enum\n  +Обоснование : String\n}\n\nclass Файл {\n  +Тип : String\n  +Название : String\n  +ДатаЗагрузки : Date\n  +Описание: String\n  +Актуальность : Boolean\n  +Доступнов=сть : Boolean\n}\n\n&#39; Связи между классами\nКаталог -- Классификация\nКаталог -- ОКПД2\nКаталог -  ПО\nКаталог -- КлассификацияПерсонала\nКаталог --  Позиция\n\nРеестрПроектов -- ПроектИзменений\nПроектИзменений --  СтатусПроекта\nПроектИзменений -- ЗаявкаНаИзменение\nПроектИзменений -- ПричинаОбращения\n\nПроектИзменений -  Файл\n\n&#39; Агрегация с Каталогом\nРеестрПроектов - Каталог : изменяет &gt;\n\n\nnote top of ОКПД2\n  Общероссийский классификатор\n  продукции по видам деятельности\nend note\n\nnote top of СтатусПроекта\n  Возможные статусы:\n  - Новый\n  - На согласовании\n  - На доработке\n  - Утвержден\n  - Отклонен\nend note\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="eZpZCb4Ox_NY9qYMojnB-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-1329" y="1523" width="1319" height="630.93" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="eZpZCb4Ox_NY9qYMojnB-2" value="Диаграмма Классов" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="-768" y="1458" width="204" height="36" as="geometry" />
        </mxCell>
        <mxCell id="TUSBtOI94vvjy1aQvT1U-3" value="" style="ellipse;html=1;shape=endState;fillColor=strokeColor;" parent="1" vertex="1">
          <mxGeometry x="1772" y="419" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="T3H-i0QyfX5pGtQ1jNJ8-1" value="Процесс -&lt;div&gt;выбора файлов для обоснования Проекта&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="3658" y="1237" width="414" height="60" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml КаталогКорпоративныхУслуг_Activity_v3\n\ntitle Процесс управления ККСУ\n\nstart\n\npartition Инициирование {\n  :Ответственный выбирает тип операции;\n  if (Тип операции) then (Добавление)\n    :Заполнение данных новой позиции:\n     - Наименование ПО\n     - ОКПД2\n     - Квалификация персонала\n     - % субподряда|;\n  elseif (Редактирование)\n    :Выбор позиции из Каталога;\n    :Корректировка данных;\n  elseif (Удаление)\n    :Выбор позиции для исключения;\n    :Указание причины;\n  endif\n\n  :Прикрепление обязательных документов:\n   - Заявка\n   - Обоснование\n   - Подтверждающие файлы|;\n}\n\npartition Валидация {\n  :Система проверяет:\n   - Заполнение обязательных полей\n   - Корректность % субподряда\n   - Наличие подписей|;\n  if (Данные корректны?) then (Да)\n    :Проект сохраняется;\n  else (Нет)\n    :Возврат с указанием ошибок;\n    stop\n  endif\n}\n\npartition Согласование {\n  repeat\n    :Назначение согласующих:\n     - Департамент закупок\n     - Профильное управление\n     - ЦЗК|;\n    :Ожидание решения;\n    if (Есть замечания?) then (Да)\n      :Фиксация замечаний;\n      :Доработка проекта;\n    endif\n  repeat while (Утверждено ЦЗК?) is (Нет)\n  -&gt;Да;\n}\n\npartition Реализация {\n  :Внесение изменений в Каталог;\n  :Обновление реестра (макс. 3 дня);\n  :Уведомление подписчиков;\n  :Публикация на портале;\n}\n\npartition Контроль {\n  :Мониторинг использования 30 дней;\n  if (Обнаружены проблемы?) then (Да)\n    :Инициирование корректировки;\n  else (Нет)\n    :Закрытие процесса;\n  endif\n}\n\nstop\n\nnote right\n  **Регламентные сроки:**\n  1. Рассмотрение на этапе - 5 раб.дней\n  2. Актуализация Каталога - ≤3 раб.дня\n  3. Ответ на ТКП - 5 раб.дней\n  4. Контрольный период - 30 дней\nend note\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="F8TrpuonONkKCqmIdGSP-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="2661" y="20" width="684" height="1749" as="geometry" />
          </mxCell>
        </UserObject>
