          </mxCell>
        </UserObject>
        <mxCell id="2zxIaBdjncgKZt1yQ0AV-1" value="&lt;span id=&quot;docs-internal-guid-6a391d50-7fff-4114-3d27-bd1afa0d93cd&quot;&gt;&lt;p style=&quot;line-height:1.3900000000000001;margin-top:12pt;margin-bottom:12pt;&quot; dir=&quot;ltr&quot;&gt;&lt;font&gt;&lt;span style=&quot;font-size: 12pt; font-family: Calibri, sans-serif; background-color: transparent; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; vertical-align: baseline; white-space-collapse: preserve;&quot;&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Р&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;и&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;сунок&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt; 1. Диаграмма активности аккредитации участников.&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt; &lt;/font&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;СТА&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-family: Calibri, sans-serif; font-size: 12pt; white-space-collapse: preserve;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;РАЯ&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-827" y="-240" width="457" height="40" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nleft to right direction\n\nactor \&quot;Поставщик\&quot; as Supplier\nactor \&quot;Секретарь ЗК\&quot; as SecZK\nactor \&quot;Оператор аккредитации\\n(внешний)\&quot; as OperatorEXT\nactor \&quot;Оператор аккредитации\\n(внутренний)\&quot; as OperatorIN\nactor \&quot;Эксперт по аккредитации\&quot; as Expert\nactor \&quot;Система АИСУЗ\&quot; as AISUZ\n\nrectangle \&quot;Сервис «Аккредитация поставщиков»\&quot; {\n  \n  usecase \&quot;UC-24-1/1\\nПодача заявки\&quot; as UC1\n  usecase \&quot;UC-24-1/2\\nПринятие заявки\\nСекретарём ЗК\&quot; as UC2\n  usecase \&quot;UC-24-1/3\\nПроверка комплектности\&quot; as UC3\n  usecase \&quot;UC-24-1/4\\nНазначение эксперта\&quot; as UC4\n  usecase \&quot;UC-24-1/5\\nОценка заявки\&quot; as UC5\n  usecase \&quot;UC-24-1/6\\nОтвет на дозапрос\&quot; as UC6\n  usecase \&quot;UC-24-1/7\\nРегистрация решения\\nи синхронизация\&quot; as UC7\n\n  UC5 .down.&gt; UC6 : &lt;&lt;extend&gt;&gt; при необходимости\n  UC5 --&gt; UC7 : &lt;&lt;include&gt;&gt; при завершении\n}\n\nSupplier --&gt; UC1\nSupplier --&gt; UC6\n\nSecZK --&gt; UC2\nOperatorEXT --&gt; UC3\nOperatorEXT --&gt; UC4\nOperatorIN --&gt; UC4\n\nExpert --&gt; UC5\n\nAISUZ --&gt; UC7\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="2zxIaBdjncgKZt1yQ0AV-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
