        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-16" value="Нет" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1194" y="551.36" width="48" height="25.24" as="geometry" />
