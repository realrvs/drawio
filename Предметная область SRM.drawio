        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml КаталогУслуг_Class_v2\n\nclass Каталог {\n  +НомерПозиции : Int\n  +НаименованиеПО : String\n  +Классификация : String\n  +ДатаИзменения : Date\n  +ОКПД2 : String\n  +КвалиффикацияПерсонала : String\n  +НаличиеМТР : String\n  +РазрешительнаяДокументация : String\n  +ОпытОказанияУслуг : String\n  +ДоляПривлеченияСубподряда : Int\n  +ПричинаОбращения : String\n  +ГергафическийПризнак : String\n  +ПротоколЦЗК : String\n  +ПереченьОбъектовГруппы : String\n}\n\nclass Классификация {\n  +Код : Int\n  +Наименование : String\n}\n\nclass КлассификацияПерсонала {\n  +Код : Int\n  +Наименование : String\n}\n\nclass ОКПД2 {\n  +Код : Int\n  +Наименование : String\n}\n\nclass ПО {\n  +КодОрганизации : Int\n  +Наименование : String\n  +КраткоеНаименование : String\n  +ИНН : Int\n  +КПП : Int\n  +ОГРН : Int\n}\n\nclass РеестрПроектов {\n  +НомерПроекта : Int\n  +НаименованиеПроекта : String\n  +ПротоколЦЗК : String\n  +Файл : Binary\n  +СтатусПроекта : String\n}\n\nclass СтатусПроекта {\n  +КодСтатуса : Int\n  +Наименование : String\n}\n\nclass ЗаявкаНаИзменение {\n  +НомерЗаявки : Int\n  +ДатаСоздания : Date\n  +ТипИзменения : String\n}\n\nclass ПричинаОбращения {\n  +КодПричины : Int\n  +Описание : String\n}\n\nclass ПроектИзменений {\n  +Номер : Int\n  +ДатаСоздания : Date\n  +Наименование : String\n  +Классификация : String\n  +ПО : String\n  +КвалификацияПерсонала : String\n  +ОпытОказанияУслуг : String\n  +ДоляПривлеченияСубподряда : String\n  +ОбоснованиеВнесенияИзменений : String\n  +ОбоснованиеПривлеченияСубподрядаБолее25% : String\n  +ПричинаОбращения : String\n  +ГеографическийПризнак : String\n  +ПереченьОбъектовГруппы : String\n}\n\nclass Позиция {\n  +Код : Int\n  +ТипИзменения : Enum\n  +Обоснование : String\n}\n\nclass Файл {\n  +Тип : String\n  +Название : String\n  +ДатаЗагрузки : Date\n  +Описание: String\n  +Актуальность : Boolean\n  +Доступнов=сть : Boolean\n}\n\n&#39; Связи между классами\nКаталог -- Классификация\nКаталог -- ОКПД2\nКаталог -  ПО\nКаталог -- КлассификацияПерсонала\nКаталог --  Позиция\n\nРеестрПроектов -- ПроектИзменений\nПроектИзменений --  СтатусПроекта\nПроектИзменений -- ЗаявкаНаИзменение\nПроектИзменений -- ПричинаОбращения\n\nПроектИзменений -  Файл\n\n&#39; Агрегация с Каталогом\nРеестрПроектов - Каталог : изменяет &gt;\n\n\nnote top of ОКПД2\n  Общероссийский классификатор\n  продукции по видам деятельности\nend note\n\nnote top of СтатусПроекта\n  Возможные статусы:\n  - Новый\n  - На согласовании\n  - На доработке\n  - Утвержден\n  - Отклонен\nend note\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="eZpZCb4Ox_NY9qYMojnB-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-1329" y="1523" width="1319" height="630.93" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="eZpZCb4Ox_NY9qYMojnB-2" value="Диаграмма Классов" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1" vertex="1" parent="1">
