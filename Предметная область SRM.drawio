          </mxGeometry>
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-7" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 255), rgb(205, 205, 255)); background-color: transparent;&quot;&gt;для инфо:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;когда все проголосовали Секретарь вне системы (в почте) через Нач.УПЗиО - ГД РГС - Нач. ДЗ направляет на подписание Председателю и бюллетень и протокол,&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;потом сам подвешивает документы в АИСУЗ и отжимает бюллетень,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;затем направляет протокол на Подписание&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;и пишем в почту помощнице Педседателя, чтобы та отжала Протокол под его учеткой&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="30" y="397.49" width="250" height="85.75" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-8" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=light-dark(#0000FF,#0000FF);" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="80" y="522.36" as="sourcePoint" />
            <mxPoint x="150" y="611" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-9" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;(в работу сначала попадает к Нач.УПЗиО, назначает секретаря)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;секретарь расписывает на согласование веером, согласующие расписывают ниже через &quot;Назначение дополнительных согласующих&quot; потом принимают их отчеты и отчитываются сами,&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;когда у секретаря прогресс по согласованию обращения Х/Х (все), то в его задачах обращение должно подкраситься и прийти уведомление&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;далее секретарь готовит или проект протокола или материалы на возврат,&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;вне системы (руководители захотели в почте) согласовывает решение с Нач.УПЗиО - Директором РГС - Нач. ДЗ&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;секретарь отчитывается по задаче &quot; @ &quot;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;НачУПЗиО:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;- принимает положительный отчет - секретарь может проект протокола направить на голосование&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;- принимает отрицательный отчет - обращение возвращается на доработку Директору ПО&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1113" y="1050" width="402" height="240" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-12" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;если среди лотов в составе обращения есть лот с признаком &quot;инноватика&quot;, то добавляется шаг &quot;Согласование ДИР&quot; (Деп. инновационного развития)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1252" y="774.13" width="250" height="85.75" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-13" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=light-dark(#FF0000,#0000FF);" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1240" y="794.8860317460318" as="sourcePoint" />
            <mxPoint x="1050" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-14" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=light-dark(#FF0000,#0000FF);" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1180.5" y="959.9960317460318" as="sourcePoint" />
            <mxPoint x="1070" y="1014.11" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-16" value="Нет" style="text;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1194" y="551.36" width="48" height="25.24" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-17" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;все шаги - это &quot;согласование&quot; и возврат на доработку предусмотрен на каждом этапе,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;должен быть и возврат предыдущему по цепочке и/или сразу Инициатору&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(обрати внимание: сейчас возвраты нарисованы &quot;самому себе&quot;)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1321" y="480" width="250" height="125.75" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-18" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;@&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1070" y="910" width="250" height="85.75" as="geometry" />
        </mxCell>
        <mxCell id="amQEoKnhqeJ1ExGjJ7Xw-19" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=light-dark(#0000FF,#0000FF);" parent="1" edge="1">
