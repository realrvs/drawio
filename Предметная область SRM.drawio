        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\n&lt;style&gt;\n diamond {\n    BackgroundColor #00000\n  }\n&lt;/style&gt;\n\nstart\n\n#ffffff:Пользователь инициирует вопрос на ЦЗК;\nif (Создание через контейнер / жалобу / договор?) then (Да)\n#ffffff  :Формируется объект \&quot;Вопрос\&quot;;\nelse\n#ffffff  :Создание вручную через \&quot;Добавить\&quot;;\n#ffffff  :Заполнение полей формы \&quot;Вопрос\&quot;;\nendif\n\n#ffffff:Отправка вопроса для включения в Обращение;\n#ffffff:Создание Обращения в ЦЗК;\n#ffffff:Выбор актуальных вопросов;\n\nrepeat\n#ffffff:Заполнение вкладок: \&quot;Основные данные\&quot;, \&quot;Вопросы\&quot;, \&quot;Текст обращения\&quot;;\n\nrepeat while (Все данные заполнены?) is (Нет) not (Да)\n#ffffff  :Сохранение Обращения;\n\n\n\n#ffffff:Инициирование согласования Обращения;\n#ffffff:Согласование Обращения;\n\n#ffffff:Создание проекта протокола ЦЗК;\n#ffffff:Создание бюллетеней для голосования;\n#ffffff:Запуск голосования;\nrepeat\n#ffffff  :Голосование членами ЦЗК;\nrepeat while (Все проголосовали?) is (Нет)\n\n#ffffff:Расчет кворума;\nif (Кворум достигнут?) then (Да)\n#ffffff  :Создание итогового протокола;\n#ffffff  :Подписание итогового протокола;\n  stop\nelse\n#ffffff  :Возврат на доработку или приостановка;\n  stop\nendif\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="3IYE7sTVI9isKnV27JDY-1">
