        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Use Case: Сервис Экспертиза\n\nleft to right direction\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EEF\n  BorderColor black\n  ArrowColor gray\n}\nskinparam note {\n  BackgroundColor #FDFDFD\n  BorderColor #CCC\n  FontColor #666\n}\n\n\nactor \&quot;Эксперт\&quot; as Expert\nactor \&quot;Куратор ЭГ\&quot; as Curator\nactor \&quot;Секретарь ЗК\&quot; as Secretary\n\npackage \&quot;Работа с ИЭЗ\&quot; {\n  usecase \&quot;[UC-19-1/1] Просмотр ИЭЗ\&quot;\n  usecase \&quot;[UC-19-1/2] Редактировать ИЭЗ (замечания, оценки, обоснования)\&quot;\n  usecase \&quot;[UC-19-1/3] Отправить ИЭЗ на согласование\&quot;\n  usecase \&quot;[UC-19-1/9] Провести дополнительную экспертизу\&quot;\n  usecase \&quot;[UC-19-1/15] Привлечь дополнительного эксперта\&quot;\n}\n\npackage \&quot;Проверка ИЭЗ\&quot; {\n  usecase \&quot;[UC-19-1/8] Проверить и принять ИЭЗ\&quot;\n  usecase \&quot;[UC-19-1/10] Отправить ИЭЗ на доработку\&quot;\n}\n\npackage \&quot;Работа с СЭЗ\&quot; {\n  usecase \&quot;[UC-19-1/4] Создать СЭЗ\&quot;\n  usecase \&quot;[UC-19-1/6] Редактировать СЭЗ\&quot;\n  usecase \&quot;[UC-19-1/7] Отправить СЭЗ на согласование\&quot;\n  usecase \&quot;[UC-19-1/5] Просмотр СЭЗ\&quot;\n}\n\npackage \&quot;Работа с дозапросами\&quot; {\n  usecase \&quot;[UC-19-1/11] Создать дозапрос для СЭЗ\&quot;\n  usecase \&quot;[UC-19-1/13] Отправить дозапрос на согласование вЭТП\&quot;\n  usecase \&quot;[UC-19-1/14] Получить ответ на дозапрос\&quot;\n  usecase \&quot;[UC-19-1/12] Посмотреть дозапрос\&quot;\n}\n\n&#39; Role bindings\nExpert --&gt; \&quot;[UC-19-1/2] Редактировать ИЭЗ (замечания, оценки, обоснования)\&quot;\nExpert --&gt; \&quot;[UC-19-1/3] Отправить ИЭЗ на согласование\&quot;\nExpert --&gt; \&quot;[UC-19-1/9] Провести дополнительную экспертизу\&quot;\nExpert --&gt; \&quot;[UC-19-1/1] Просмотр ИЭЗ\&quot;\n\nCurator --&gt; \&quot;[UC-19-1/8] Проверить и принять ИЭЗ\&quot;\nCurator --&gt; \&quot;[UC-19-1/10] Отправить ИЭЗ на доработку\&quot;\nCurator --&gt; \&quot;[UC-19-1/4] Создать СЭЗ\&quot;\nCurator --&gt; \&quot;[UC-19-1/6] Редактировать СЭЗ\&quot;\nCurator --&gt; \&quot;[UC-19-1/7] Отправить СЭЗ на согласование\&quot;\nCurator --&gt; \&quot;[UC-19-1/5] Просмотр СЭЗ\&quot;\nCurator --&gt; \&quot;[UC-19-1/15] Привлечь дополнительного эксперта\&quot;\nCurator --&gt; \&quot;[UC-19-1/1] Просмотр ИЭЗ\&quot;\n\nSecretary --&gt; \&quot;[UC-19-1/11] Создать дозапрос для СЭЗ\&quot;\nSecretary --&gt; \&quot;[UC-19-1/13] Отправить дозапрос на согласование вЭТП\&quot;\nSecretary --&gt; \&quot;[UC-19-1/14] Получить ответ на дозапрос\&quot;\nSecretary --&gt; \&quot;[UC-19-1/4] Создать СЭЗ\&quot;\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rzQqVE924bvMfwkl_zbS-1">
