  <diagram id="8C0aY7ka68PjK1EtRMji" name="2.22. Договоры">
    <mxGraphModel dx="4816" dy="892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="88kHtGoHoPnXFfIdBZo5-1" value="Статусная модель" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="55" y="98" width="130" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam state {\n  BackgroundColor&lt;&lt;Terminal&gt;&gt; PaleGreen\n  BorderColor&lt;&lt;Terminal&gt;&gt; DarkGreen\n}\n\n[*] --&gt; Проект\n\nstate Проект {\n}\n\nstate \&quot;На размещении\&quot; as Placement\nstate \&quot;На доработке\&quot; as Revision\nstate Согласован\nstate Исполнение\nstate \&quot;Исполнение завершено\&quot; as ExecutionComplete &lt;&lt;Terminal&gt;&gt;\nstate \&quot;Исполнение прекращено\&quot; as ExecutionTerminated &lt;&lt;Terminal&gt;&gt;\nstate Удалён &lt;&lt;Terminal&gt;&gt;\n\nПроект --&gt; Placement : Сохранить и отправить на размещение  \nПроект --&gt; Удалён     : Удалить  \n\nPlacement --&gt; Согласован : Пакет в ЕИС → «Размещён»  \nPlacement --&gt; Revision   : Обнаружены ошибки при проверке  \nPlacement --&gt; Проект    : Отозвать размещение  \n\nRevision --&gt; Проект : После правок  \nRevision --&gt; Удалён : Удалить  \n\nСогласован --&gt; Исполнение : Договор подписан и вступил в силу  \n\nИсполнение --&gt; ExecutionComplete   : Авто-переход после последнего акта  \nИсполнение --&gt; ExecutionTerminated : Фиксация расторжения  \n\nExecutionComplete --&gt; [*]  \nExecutionTerminated --&gt; [*]  \nУдалён --&gt; [*]\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-202.5" y="160" width="645" height="726" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n&#39; Define PK/FK stereotypes\nskinparam classAttributeIconSize 0\n\nentity \&quot;contracts\&quot; as contracts {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    contract_number : varchar(50)\n    contract_date : date\n    purchase_results_date : date\n    signed_date : date\n    end_date : date\n    notice_registration_number : varchar(50)\n    notice_guid : UUID\n    lot_guid : UUID\n    purchase_name : varchar(255)\n    procurement_presence : boolean\n    procurement_method : varchar(50)\n    is_electronic : boolean\n    participants_only_msp : boolean\n    must_engage_subcontractors : boolean\n    subcontractors_total_amount : decimal(18,2)\n    termination_on_expiry : boolean\n    extension_allowed : boolean\n    antimonopoly_flag : boolean\n    antimonopoly_date : date\n    price_without_vat : decimal(18,2)\n    vat_rate : decimal(5,2)\n    price_with_vat : decimal(18,2)\n    currency : char(3)\n    currency_rate : decimal(18,6)\n    price_in_rub : decimal(18,2)\n    status : varchar(20)\n    placement_required : boolean\n    placement_skip_reason : text\n    eis_submission_date : date\n    eis_publication_date : date\n  --\n    customer_org_id   : UUID &lt;&lt;FK&gt;&gt;\n    contractor_org_id : UUID &lt;&lt;FK&gt;&gt;\n    lot_id            : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_subcontractors\&quot; as cs {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    fill_manually      : boolean\n    name               : varchar(255)\n    is_resident        : boolean\n    taxpayer_code      : varchar(50)\n    reg_date           : date\n    okopf              : varchar(20)\n    inn                : varchar(20)\n    kpp                : varchar(20)\n    ogrn               : varchar(20)\n    okpo               : varchar(20)\n    country            : varchar(100)\n    region             : varchar(100)\n    postal_code        : varchar(20)\n    district           : varchar(100)\n    city               : varchar(100)\n    settlement         : varchar(100)\n    street             : varchar(100)\n    building           : varchar(20)\n    office             : varchar(20)\n    email              : varchar(100)\n    phone              : varchar(30)\n    is_affiliated      : boolean\n    is_msp             : boolean\n    msp_category       : varchar(20)\n    created_at         : timestamp\n    updated_at         : timestamp\n  --\n    contract_id         : UUID &lt;&lt;FK&gt;&gt;\n    subcontractor_org_id: UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_files\&quot; as cf {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    file_type  : varchar(50)\n    description: text\n    file_url   : varchar(512)\n    uploaded_at: timestamp\n  --\n    contract_id : UUID &lt;&lt;FK&gt;&gt;\n    uploaded_by : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_approvals\&quot; as ca {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    approver_role: varchar(50)\n    status       : varchar(20)\n    sent_at      : timestamp\n    approved_at  : timestamp\n    comments     : text\n  --\n    contract_id : UUID &lt;&lt;FK&gt;&gt;\n    approver_id : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_amendments\&quot; as cam {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    amendment_type: varchar(50)\n    description   : text\n    status        : varchar(20)\n    created_at    : timestamp\n    approved_at   : timestamp\n  --\n    contract_id  : UUID &lt;&lt;FK&gt;&gt;\n    initiated_by : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_execution\&quot; as ce {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    execution_date   : date\n    doc_type         : varchar(50)\n    doc_file_url     : varchar(512)\n    status           : varchar(20)\n    description      : text\n    execution_amount : decimal(18,2)\n    created_at       : timestamp\n    updated_at       : timestamp\n  --\n    contract_id : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_notifications\&quot; as cn {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    notification_type: varchar(50)\n    message          : text\n    is_read          : boolean\n    sent_at          : timestamp\n  --\n    contract_id: UUID &lt;&lt;FK&gt;&gt;\n    user_id    : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_msp\&quot; as cmsp {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    msp_type        : varchar(50)\n    msp_registration: varchar(50)\n    inclusion_date  : date\n    msp_report      : text\n  --\n    contract_id: UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;contract_history\&quot; as ch {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n    change_date       : timestamp\n    change_description: text\n    event_type        : varchar(50)\n  --\n    contract_id: UUID &lt;&lt;FK&gt;&gt;\n    user_id    : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;users\&quot; as users {\n  * id          : UUID &lt;&lt;PK&gt;&gt;\n  --\n    full_name    : varchar(255)\n    login        : varchar(100)\n    email        : varchar(100)\n    role         : varchar(50)\n    is_active    : boolean\n    registered_at: timestamp\n}\n\nentity \&quot;external_integrations\&quot; as ei {\n  * id               : UUID &lt;&lt;PK&gt;&gt;\n  --\n    system_name       : varchar(100)\n    integration_status: varchar(50)\n    last_synced_at    : timestamp\n    integration_message: text\n  --\n    contract_id: UUID &lt;&lt;FK&gt;&gt;\n}\n\n&#39; Stub entities for referenced tables\nentity \&quot;organisations\&quot; as orgs {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n}\n\nentity \&quot;lots\&quot; as lots {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n}\n\n&#39; Relationships\ncontracts }|--|| orgs : customer_org_id\ncontracts }|--|| orgs : contractor_org_id\ncontracts }|--|| lots : lot_id\n\ncontracts ||--o{ cs : \&quot;\&quot;\ncs }|--|| orgs : subcontractor_org_id\n\ncontracts ||--o{ cf : \&quot;\&quot;\ncf }o--|| users : uploaded_by\n\ncontracts ||--o{ ca : \&quot;\&quot;\nca }o--|| users : approver_id\n\ncontracts ||--o{ cam : \&quot;\&quot;\ncam }o--|| users : initiated_by\n\ncontracts ||--o{ ce : \&quot;\&quot;\n\ncontracts ||--o{ cn : \&quot;\&quot;\ncn }o--|| users : user_id\n\ncontracts ||--o{ cmsp : \&quot;\&quot;\n\ncontracts ||--o{ ch : \&quot;\&quot;\nch }o--|| users : user_id\n\ncontracts ||--o{ ei : \&quot;\&quot;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="88kHtGoHoPnXFfIdBZo5-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-3300" y="120" width="2764" height="1372" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="88kHtGoHoPnXFfIdBZo5-4" value="Таблица БД" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1855" y="38" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="88kHtGoHoPnXFfIdBZo5-5" value="Use case" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1185" y="328" width="70" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Пользователь\&quot; as User\nactor \&quot;Согласующее\\nлицо\&quot; as Approver\nactor \&quot;Оператор\&quot; as Operator\nactor \&quot;Администратор\&quot; as Admin\nactor \&quot;Аналитик\\n/ Руководитель\&quot; as Analyst\n\nusecase UC01  as \&quot;Создание договора\\n(UC-01)\&quot;\nusecase UC02  as \&quot;Загрузка файлов\\n(UC-02)\&quot;\nusecase UC04  as \&quot;Обработка замечаний\\n(UC-04)\&quot;\nusecase UC06  as \&quot;Интеграция с\\nвнешними системами\\n(UC-06)\&quot;\nusecase UC07  as \&quot;Управление\\nсубподрядчиками\\n(UC-07)\&quot;\nusecase UC0741 as \&quot;Взаимозависимые\\nлица\\n(UC-07-4/1)\&quot;\nusecase UC08  as \&quot;Управление договорами\\nМСП\\n(UC-08)\&quot;\nusecase UC09  as \&quot;Исполнение договора\\n(UC-09)\&quot;\nusecase UC10  as \&quot;Изменение условий\\nдоговора\\n(UC-10)\&quot;\nusecase UC12  as \&quot;Расторжение договора\\n(UC-12)\&quot;\nusecase UC13  as \&quot;Формирование\\nотчётности\\n(UC-13)\&quot;\nusecase UC14  as \&quot;Ведение истории\\nизменений\\n(UC-14)\&quot;\nusecase UC15  as \&quot;Просмотр и поиск\\nдоговоров\\n(UC-15)\&quot;\nusecase UC16  as \&quot;Уведомления\\nпользователей\\n(UC-16)\&quot;\nusecase UC4011 as \&quot;Создание договора из\\nреестра закупок\\n(UC-40-1/1)\&quot;\nusecase UC4022 as \&quot;Создание «пустого»\\nдоговора\\n(UC-40-2/2)\&quot;\n\nUser      --&gt; UC01\nUser      --&gt; UC02\nUser      --&gt; UC07\nUser      --&gt; UC0741\nUser      --&gt; UC08\nUser      --&gt; UC09\nUser      --&gt; UC15\nUser      --&gt; UC16\nUser      --&gt; UC4011\nUser      --&gt; UC4022\n\nUser      --&gt; UC04\nApprover  --&gt; UC04\n\nUser      --&gt; UC10\nApprover  --&gt; UC10\n\nUser      --&gt; UC12\nApprover  --&gt; UC12\n\nOperator  --&gt; UC06\nAdmin     --&gt; UC06\n\nAnalyst   --&gt; UC13\nAnalyst   --&gt; UC14\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1041" y="390" width="400" height="1596" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Диаграмма внешней интеграции\n\nrectangle \&quot;Сервис договоров\&quot; as Service\n\nrectangle \&quot;ЕИС (закупки)\&quot; as EIS\nrectangle \&quot;ОСРГ (РусГидро)\&quot; as OSRG\nrectangle \&quot;Справочники внешних организаций\&quot; as REFS\nrectangle \&quot;ERP/финансовые системы\&quot; as ERP\nrectangle \&quot;Субподрядчики\&quot; as SUBS\ndatabase  \&quot;БД договоров\&quot; as DB\n\nService --&gt; EIS : SOAP, REST, XML, XLSX\nService --&gt; OSRG : SOAP, XML\nService --&gt; REFS : REST, JSON, XML\nService --&gt; ERP : REST, XML, XLSX, CSV\nService --&gt; SUBS : REST, JSON\nService --&gt; DB  : JDBC/ORM\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="88kHtGoHoPnXFfIdBZo5-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-2940" y="1850" width="1074" height="213" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Диаграмма активности: Интеграция с внешними системами\n\nstart\n:Сформировать пакет данных о договорах\\n(для ЕИС, ОСРГ и др.);\n:Автоматически отправить данные\\nво внешние системы (ЕИС/ОСРГ);\n:Ожидать и обработать ответы от внешних систем;\n\nif (Ответ успешный?) then (да)\n  :Импортировать информацию из внешних систем;\n  :Провести сверку данных\\n(федеральные и корпоративные реестры);\n\n  if (Есть несоответствия?) then (да)\n    :Сформировать уведомления о несоответствиях;\n    :Запросить уточнение данных или корректировку;\n  else (нет)\n    :Обновить статусы интеграции;\n  endif\n\n  stop\n\nelse (нет)\n  :Сформировать и отправить уведомление\\nо сбое/ошибке передачи;\n  :Повторить отправку или эскалировать проблему;\n  stop\nendif\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-8">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-3220" y="2430" width="822" height="638" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Пользователь|\nstart\n:Выбрать тип документа\\n(договор, приложение, акт и др.);\n\n|Система|\n:Автоматически подставить данные в шаблон;\n\n|Пользователь|\nif (Требуется редактирование?) then (да)\n  :Внести правки в документ;\nendif\n\n:Сохранить или выгрузить документ;\n\n|Система|\n:Выполнить валидацию документа:\\n\n• Проверить структуру и разделы;\\n\n• Проверить формат и обязательные поля (Минфин, Казначейство);\\n\n• Проверить номера страниц и подписи;\n\nif (Ошибок нет?) then (да)\n  :Генерировать итоговый документ;\nelse (нет)\n  :Показать список ошибок и предупреждений;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-9">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-1950" y="2430" width="744" height="633" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Пользователь|\nstart\n:Открыть карточку договора;\n:Перейти в раздел «Субподрядчики»;\n\n|Система|\n:Отобразить текущий реестр субподрядчиков;\n\n|Пользователь|\n:Нажать «Добавить субподрядчика»;\n\n:Ввести данные субподрядчика;\n:Проверить и указать взаимозависимость\\nили принадлежность к МСП;\n\n|Система|\n:Проверить соответствие ПП-301;\n\nif (Требуются дополнительные документы?) then (да)\n  |Система|\n  :Запросить уточнения и дополнительные документы;\n  |Пользователь|\n  :Загрузить запрошенные документы;\n  |Система|\n  :Повторно проверить документы;\nendif\n\n|Система|\n:Сохранить запись о субподрядчике;\n:Обновить структуру реестра субподрядчиков;\n\n|Пользователь|\n:Просмотреть обновлённый реестр;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-10">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-450" y="2380" width="619" height="901" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Пользователь|\nstart\n:Перейти к исполнению договора;\n\nrepeat\n    :Ввести информацию по этапу\\n(дата, сумма, описание);\n    |Система|\n    :Фиксировать этап в истории исполнения;\n    :Отправить данные в ЕИС и ОСРГ;\n    |Пользователь|\nrepeat while (Остались этапы?)\n\n|Система|\n:Закрыть договор;\n:Фиксировать завершение исполнения;\n:Сформировать и отправить отчеты\\nдля ЕИС и Казначейства;\n\n|Пользователь|\n:Просмотреть историю исполнения договора;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-11">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="580" y="2430" width="571" height="645" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Пользователь|\nstart\n:Выбрать договор для изменения;\n:Инициировать проект изменений\\n(п. 3.5 «Изменение условий договора»);\n:Ввести новые значения параметров\\n(сумма, сроки, предмет и др.);\n|Система|\n:Сохранить проект изменений\\n(статус «Проект»);\n:Зафиксировать версию изменений в истории;\\n(п. 5 «Ведение истории изменений»);\n:Уведомить ответственных лиц о фиксации изменений\\n(по настройкам уведомлений);\n:Отправить версию договора в ЕИС и ОСРГ;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-12">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1470" y="2450" width="606" height="543" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|User|\nstart\n\n:Нажать \&quot;Создать договор\&quot;;\n:Выбрать шаблон договора;\n:Ввести реквизиты договора\\n(контрагент, сумма, предмет);\n:Загрузить файлы и приложения;\n:Проверить корректность данных\\n(валидация по 173н и ПП-1132);\n\nif (Данные корректны?) then (да)\n  :Сохранить черновик договора;\n  :Дозаполнить данные по договору\\nи приложить файлы;\n  :Отправить в Реестр договоров\\nв ЕИС;\nelse (нет)\n  :Показать ошибки и подсказки;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="88kHtGoHoPnXFfIdBZo5-13">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="2640" y="2430" width="424" height="621" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nstart\n\n:Открыть реестр договоров;\n:Создать новый договор;\n:Заполнить реквизиты, приложить файлы;\n:Сохранить черновик;\n:Проверка обязательных полей;\n\nif (Есть ошибки?) then (да)\n    :Показать ошибки пользователю;\n    stop\nelse (нет)\n    :Сформировать карточку договора;\nendif\n\n:Проверка принадлежности к МСП и взаимозависимых лиц;\nif (МСП/ВЗЛ?) then (да)\n    :Заполнить раздел по МСП/ВЗЛ;\nendif\n\n:Определить необходимость субподрядчиков;\nif (Есть субподрядчики?) then (да)\n    :Ввести данные по субподрядчикам;\n    :Сохранить сведения по субподрядным договорам;\nendif\n\n:Отправить договор на согласование;\n\n:Определение маршрута согласования;\n:Уведомление согласующих;\n\nrepeat\n    :Согласующий рассматривает договор;\n    if (Есть замечания?) then (да)\n        :Вернуть договор на доработку;\n        :Пользователь дорабатывает договор;\n        :Снова отправить на согласование;\n    else (нет)\n        :Согласование договора;\n    endif\nrepeat while (Не все согласовали?)\n\n:Формирование документов (печать/подпись);\n:Отправка/выгрузка в ЕИС (открытая часть);\n\nif (Требуется размещение в закрытой части ЕИС?) then (да)\n    :Интеграция с закрытой частью ЕИС;\nendif\n\n:Интеграция с ФК (Федеральное казначейство);\n:Интеграция с реестром ОСРГ (Группа РусГидро);\n\n:Договор подписан, статус \&quot;В работе\&quot;;\n:Ведение истории изменений и версий;\n\nwhile (Договор в работе)\n    :Исполнение договора;\n    :Загрузка актов, счетов, дополнительных соглашений;\n    if (Необходимы изменения?) then (да)\n        :Создать проект изменений;\n        :Согласование изменений;\n    endif\n    if (Необходимость расторжения?) then (да)\n        :Инициировать процедуру расторжения;\n        :Согласование расторжения;\n        :Обновить статус \&quot;Расторгнут\&quot;;\n        break\n    endif\nendwhile\n\n:Завершение исполнения;\n:Обновить статус \&quot;Завершен\&quot;;\n\n:Формирование и отправка итоговых отчетов (в т.ч. для ЕИС, ОСРГ, внутреннего аудита);\n\nstop\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="4qahBVPiRIJRszp6xCOT-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="1990" y="210" width="540" height="2722" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ci1F8mIzqA39p51n-x7D" name="2.20. КЦД">
    <mxGraphModel dx="6084" dy="1336" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|Пользователь|\nstart\n:Нажать «…» рядом с полем «Лот»;\n\n|Система|\n:Открыть модальное окно «Выбор значения: Лот»;\n:Отобразить таблицу лотов;\n\n|Пользователь|\nif (Нужно уточнить поиск?) then (да)\n  :Ввести текст в строку поиска;\n  |Система|\n  :Отфильтровать список лотов;\n  |Пользователь|\nendif\n:Прокрутить список или напрямую выбрать строку;\n:Клик по нужной записи;\n\n:Нажать «ОК»;\n\n|Система|\n:Закрыть модальное окно;\n:Подставить номер лота и предмет договора в поле «Лот»;\n\nstop\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-560" y="160" width="684" height="744" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="rSTS5pRBodv4w890v1ij-2" value="&lt;strike&gt;Создание лота&lt;/strike&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-385" y="108" width="110" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|User|\nstart\n:Open \&quot;Реестр КЦД\&quot;;\n:Click \&quot;Показать фильтр\&quot;;\n\n:Enter text fields and select dropdowns;\nif (Need to pick Контрагент?) then (yes)\n    :Click \&quot;...\&quot; next to Контрагент;\n    |System|\n    :Show \&quot;Контрагенты\&quot; dialog;\n    |User|\n    :Select a Контрагент and click OK;\nendif\n\nif (Need to pick Способ закупки?) then (yes)\n    :Click \&quot;...\&quot; next to Способ закупки;\n    |System|\n    :Show \&quot;Способы закупки\&quot; dialog;\n    |User|\n    :Select a Способ закупки and click OK;\nendif\n\n:Click \&quot;Применить\&quot;;\n|System|\n:Filter records by criteria;\n:Display filtered results;\n|User|\n:View results;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-710" y="1070" width="515" height="980" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="rSTS5pRBodv4w890v1ij-4" value="Диаграмма активности" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-575" y="1018" width="150" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Пользователь\&quot; as User\n\npackage \&quot;Подсистема «Реестр КЦД»\&quot; {\n  usecase \&quot;Фильтрация реестра КЦД\\n(UC-12-01/1)\&quot; as UC1\n  usecase \&quot;Выбор контрагента\\n(UC-12-01/2)\&quot; as UC2\n  usecase \&quot;Выбор способа закупки\\n(UC-12-01/3)\&quot; as UC3\n}\n\nUser --&gt; UC1\nUser --&gt; UC2\nUser --&gt; UC3\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-5">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="20" y="1170" width="403" height="282" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="rSTS5pRBodv4w890v1ij-6" value="USe case" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="140" y="1110" width="80" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Фильтрация реестра КЦД\n\n|Пользователь|\nstart\n:Нажать «Показать фильтр»;\n\n|Система|\n:Развернуть панель фильтра с полями;\n\n|Пользователь|\n:Задать значения в полях (текст, выпадающие списки, диапазоны, справочники);\n\n|Пользователь|\n:Нажать «Применить»;\n\n|Система|\n:Выполнить фильтрацию по заданным условиям;\n:Обновить таблицу реестра;\n\n|Пользователь|\n:Просмотреть отфильтрованные записи;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-1640" y="1070" width="786" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Выбор контрагента из справочника\n\n|Пользователь|\nstart\n:Нажать «...» рядом с полем «Контрагент»;\n\n|Система|\n:Открыть модальное окно «Выбор значения: Контрагент»;\n\n|Пользователь|\n:Искать контрагента (ввод текста или прокрутка);\n:Выбрать строку;\n:Нажать «ОК»;\n\n|Система|\n:Закрыть окно;\n:Заполнить поле «Контрагент» выбранной записью;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-8">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-2490" y="1090" width="678" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Выбор способа закупки из справочника\n\n|Пользователь|\nstart\n:Нажать «...» рядом с полем «Способ закупки»;\n\n|Система|\n:Открыть модальное окно «Выбор значения: Способ закупки»;\n\n|Пользователь|\n:Прокручивать список или вводить текст для поиска;\n:Выбрать нужную строку;\n:Нажать «ОК»;\n\n|Система|\n:Закрыть окно;\n:Заполнить поле «Способ закупки» выбранной записью;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-9">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-3340" y="1120" width="714" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\n\nentity \&quot;statuses\\n(Статусы КЦД)\&quot; as STAT {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  name : VARCHAR(100&gt;\n}\n\nentity \&quot;contractors\\n(Контрагенты)\&quot; as C {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  full_name : VARCHAR(255&gt;\n  short_name : VARCHAR(150&gt;\n  inn : CHAR(10&gt;\n  kpp : CHAR(9&gt;\n  ogrn : CHAR(13&gt;\n}\n\nentity \&quot;procurement_methods\\n(Способы закупки)\&quot; as PM {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  name : VARCHAR(200&gt;\n  start_date : DATE\n  end_date : DATE\n  form : VARCHAR(50&gt;\n}\n\nentity \&quot;lots\\n(Лоты)\&quot; as L {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  lot_number : VARCHAR(50&gt;\n  subject : VARCHAR(255&gt;\n  year : SMALLINT\n  planned_price_with_vat : DECIMAL(18,2&gt;\n  procurement_method_id : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;kcd_registry\\n(Реестр КЦД)\&quot; as K {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  contractor_id : INT &lt;&lt;FK&gt;&gt;\n  lot_id : INT &lt;&lt;FK&gt;&gt;\n  customer : VARCHAR(255&gt;\n  contract_number : VARCHAR(50&gt;\n  contract_date : DATE\n  contract_price_with_vat : DECIMAL(18,2&gt;\n  upload_date : DATETIME\n  update_date : DATETIME\n  status_id : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;kcd_files\\n(Файлы КЦД)\&quot; as KF {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  kcd_id : INT &lt;&lt;FK&gt;&gt;\n  file_name : VARCHAR(255&gt;\n  file_path : VARCHAR(500&gt;\n}\n\nentity \&quot;kcd_approval_log\\n(Журнал согласования)\&quot; as KL {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  kcd_id : INT &lt;&lt;FK&gt;&gt;\n  user_id : INT\n  action_date : DATETIME\n  status_id : INT &lt;&lt;FK&gt;&gt;\n  approval_flag : BOOLEAN\n  comment : TEXT\n}\n\nC ||--o{ K : contractor_id\nL ||--o{ K : lot_id\nSTAT ||--o{ K : status_id\nPM ||--o{ L : procurement_method_id\nK ||--o{ KF : kcd_id\nK ||--o{ KL : kcd_id\nSTAT ||--o{ KL : status_id\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-10">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-2520" y="150" width="700" height="837" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="aItvVdAjgUlJAlurX9DD-1" value="&lt;font color=&quot;#ff0000&quot;&gt;Поиск по полю Лот&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
