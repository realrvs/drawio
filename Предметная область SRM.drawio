        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam style strictuml\n\nclass \&quot;Лот\&quot; {\n  +ID\n  +Номер лота\n  +Способ закупки\n  +Плановая сумма без НДС\n  +Плановая сумма с НДС\n  +Статус\n}\n\nclass \&quot;Контейнер\&quot; {\n  +ID\n  +Наименование контейнера\n  +Тип контейнера\n  +Кол-во лотов\n  +Статус\n  +Планируемая стоимость\n}\n\nclass \&quot;Обращение\&quot; {\n  +ID\n  +Номер обращения\n  +Дата создания\n  +Статус обращения\n  +Тип обращения (в ДЗ, ЦЗК)\n}\n\n\nclass \&quot;План закупок\&quot; {\n  +ID\n  +Реестровый номер в ЕИС\n  +Вид плана\n  +Версия\n  +Период действия\n  +Статус плана\n}\n\nclass \&quot;Файл/Вложение\&quot; {\n  +ID\n  +Тип файла\n  +Имя файла\n  +Версия\n  +Дата загрузки\n  +Автор\n}\n\nclass \&quot;Пользователь\&quot; {\n  +ID пользователя\n  +ФИО\n  +Роль\n  +Организация\n}\n\nclass \&quot;Организация\&quot; {\n  +ID организации\n  +Наименование\n  +Тип\n}\n\nclass \&quot;Статус\&quot; {\n  +ID \n  +Наименование\n  +Тип Объекта\n}\n\nclass \&quot;Способ закуупки\&quot; {\n  +ID \n  +Наименование\n}\n\nclass \&quot;Закупаемая продукция\&quot; {\n  +ID \n  +Лот\n  +ОКПД2\n  +ОКВЭД2\n  +Количество\n  +Единица измерения\n  +Минимально необходимые требования\n\n}\n\n\&quot;Контейнер\&quot; o-- \&quot;Лот\&quot; : включает &gt;\n\&quot;Контейнер\&quot; o-- \&quot;Обращение\&quot; : включается в &gt;\n\&quot;План закупок\&quot; o-- \&quot;Лот\&quot; : содержит &gt;\n\&quot;План закупок\&quot; o-- \&quot;Файл/Вложение\&quot; : включает &gt;\n\&quot;Контейнер\&quot; o-- \&quot;Файл/Вложение\&quot; : содержит &gt;\n\&quot;Обращение\&quot; o-- \&quot;Файл/Вложение\&quot; : содержит &gt;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="GeOUrHwO0D99lIFOv7rh-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
