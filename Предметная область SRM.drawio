        </mxCell>
        <mxCell id="JUMmye7Uaip6cw_aeajl-3" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;преддоговорные переговоры (опционально)&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;/тоже входят еще в процесс проведения закупки/&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="410" y="2590" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="JUMmye7Uaip6cw_aeajl-4" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;набор способов в РП странный...&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;Например, нет &quot;Открытый запрос котировок&quot;, &quot;Запрос предложений в эл. форме&quot;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Calibri, sans-serif&quot;&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;способы &quot;Открытый...&quot; - это &quot;бумажные&quot; закупки, они ООООчень редко проводятся и не факт, что реализованы в АИСУЗ&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="580" y="720" width="330" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="M5D3fF-1itNOgIBcN2zo" name="2.19 Экспертиза">
    <mxGraphModel dx="2016" dy="929" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Class: Основные сущности экспертизы в АИСУЗ (логическая модель)\n\nclass \&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; {\n    +ИЭЗ_ID: String\n    +Стадия: enum {отборочная, оценочная, завершена}\n    +ДатаСоздания: Date\n    +ПланСрокПодготовки: Date\n    +Статус: enum {в работе, на проверке, на доработке, принято}\n    +Направление: String\n}\n\nclass \&quot;Сводное экспертное заключение (СЭЗ)\&quot; {\n    +СЭЗ_ID: String\n    +Статус: enum {в работе, на согласовании, согласовано, с дозапросами}\n    +ДатаСоздания: Date\n    +Тип: enum {основное, по переторжке}\n}\n\nclass \&quot;Эксперт\&quot; {\n    +ID: String\n    +ФИО: String\n    +Роль: enum {член ЭГ, куратор ЭГ}\n    +Активен: Boolean\n}\n\nclass \&quot;Участник закупки\&quot; {\n    +ID: String\n    +НазваниеОрганизации: String\n    +Аккредитован: Boolean\n}\n\nclass \&quot;Предложение участника\&quot; {\n    +ID: String\n    +Статус: enum {новое, проверено, требует дозапрос}\n}\n\nclass \&quot;Замечание\&quot; {\n    +ID: String\n    +ТипДокумента: enum {ТЗ, закупочная документация, оба}\n    +Текст: String\n    +Критично: Boolean\n}\n\nclass \&quot;Критерий оценки\&quot; {\n    +ID: String\n    +Название: String\n    +Метод: enum {ручной, формула}\n    +Оценка: Float\n    +Обоснование: String\n}\n\nclass \&quot;Дозапрос\&quot; {\n    +ID: String\n    +Статус: enum {создан, отправлен, получен ответ}\n}\n\nclass \&quot;Файл\&quot; {\n    +Тип: String\n    +Имя: String\n    +Размер: Integer\n}\n\nclass \&quot;Экспертная группа\&quot; {\n    +ID: String\n    +Закупка: String\n}\n\nclass \&quot;Карточка замены эксперта\&quot; {\n    +ID: String\n    +Тип: enum {Куратор, Член ЭГ}\n    +Причина: String\n    +Дата: Date\n    +Статус: enum {Проект, На согласовании, Согласовано, Не согласовано, Замена произведена, Завершен}\n}\n\nclass \&quot;ПЗД (Пакет закупочной документации)\&quot; {\n  +ID: String\n  +ТипЗакупки: String\n}\nclass \&quot;Требование\&quot; {\n  +ID: String\n  +Описание: String\n  +Обязательное: Boolean\n}\n\n\&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; --&gt; \&quot;1\&quot; \&quot;Эксперт\&quot;\n\&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; --&gt; \&quot;1..*\&quot; \&quot;Предложение участника\&quot;\n\&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Замечание\&quot;\n\&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Критерий оценки\&quot;\n\&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Файл\&quot;\n\&quot;Сводное экспертное заключение (СЭЗ)\&quot; --&gt; \&quot;1..*\&quot; \&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot;\n\&quot;Сводное экспертное заключение (СЭЗ)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Дозапрос\&quot;\n\&quot;Дозапрос\&quot; --&gt; \&quot;1..*\&quot; \&quot;Замечание\&quot;\n\&quot;Дозапрос\&quot; --&gt; \&quot;0..*\&quot; \&quot;Файл\&quot;\n\&quot;Предложение участника\&quot; --&gt; \&quot;1\&quot; \&quot;Участник закупки\&quot;\n\&quot;Эксперт\&quot; --&gt; \&quot;0..*\&quot; \&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot;\n\&quot;Файл\&quot; --&gt; \&quot;1\&quot; \&quot;Индивидуальное экспертное заключение (ИЭЗ)\&quot;\n\&quot;Карточка замены эксперта\&quot; --&gt; \&quot;1\&quot; \&quot;Эксперт\&quot; : Заменяемый\n\&quot;Карточка замены эксперта\&quot; --&gt; \&quot;1\&quot; \&quot;Эксперт\&quot; : Заменяющий\n\&quot;Экспертная группа\&quot; --&gt; \&quot;1\&quot; \&quot;Эксперт\&quot; : Куратор\n\&quot;Экспертная группа\&quot; --&gt; \&quot;0..*\&quot; \&quot;Эксперт\&quot; : Члены\n\&quot;ПЗД (Пакет закупочной документации)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Требование\&quot;\n\&quot;ПЗД (Пакет закупочной документации)\&quot; --&gt; \&quot;0..*\&quot; \&quot;Критерий оценки\&quot;\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="gikS4-EkkRHcnsDqJiC--80">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;imageBorder=default;" parent="1" vertex="1">
            <mxGeometry x="1160" y="330" width="2302" height="708" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="gikS4-EkkRHcnsDqJiC--81" value="Использовала PlantUML. Чтобы отредактировать диаграмму кликните 2 раза по картинке" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="310" y="170" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gikS4-EkkRHcnsDqJiC--82" value="&lt;b style=&quot;font-weight:normal;&quot; id=&quot;docs-internal-guid-de981836-7fff-2019-ec9f-e40486a4540b&quot;&gt;&lt;div dir=&quot;ltr&quot; style=&quot;margin-left:0pt;&quot; align=&quot;left&quot;&gt;&lt;table style=&quot;border:none;border-collapse:collapse;&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;189&quot;&gt;&lt;col width=&quot;434&quot;&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:8pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;b&gt;Термин&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;text-align: center;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;b&gt;Определение&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Индивидуальное экспертное заключение (ИЭЗ)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Документ, формируемый членом экспертной группы по результатам анализа предложений участников закупки по закреплённому направлению оценки.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Сводное экспертное заключение (СЭЗ)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Обобщённый документ, включающий выводы всех ИЭЗ по закупке. Формируется Куратором ЭГ и/или Секретарем ЗК.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Дополнительная экспертиза&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Повторная экспертиза заявок, инициируемая после получения дополнительных материалов (например, по результатам дозапроса или переторжки).&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Дозапрос&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Запрос к участникам закупки на предоставление дополнительных документов или уточнений по выявленным замечаниям.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Реестр экспертов&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Справочник экспертов, включенных в систему, с указанием их направлений оценки, статуса и параметров экспертизы.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Сведения об эксперте&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Регламентируемая форма, используемая для включения, изменения или исключения эксперта из реестра.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Карточка эксперта&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Запись в реестре экспертов, содержащая текущие сведения об эксперте, включая статус, направления и опыт.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Куратор ЭГ&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Пользователь, координирующий работу экспертной группы, проверяющий и утверждающий ИЭЗ, &lt;/span&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 255));&quot;&gt;формирует СЭЗ.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;height:22.7pt&quot;&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: break-word;&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;line-height:1.2;margin-top:0pt;margin-bottom:0pt;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;&quot;&gt;Эксперт (Член ЭГ)&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;td style=&quot;border-width: 0.75pt; border-style: solid; border-color: rgb(0, 0, 0); vertical-align: top; padding: 3pt; overflow: hidden; overflow-wrap: 