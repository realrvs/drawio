        </mxCell>
        <mxCell id="n73FnLKVQlp9ePW6TLcR-2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=light-dark(#0000FF,#0000FF);" vertex="1" parent="L_L-WssNXw5YL5tKDDHF-1">
          <mxGeometry width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n73FnLKVQlp9ePW6TLcR-3" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;переговори с Дарьей - кто вносит в ПЗД Требования и Критерии?&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 255), rgb(0, 0, 255));&quot;&gt;(скорее: Куратог ЭГ и Отв.Исп. в ПО)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="L_L-WssNXw5YL5tKDDHF-1">
          <mxGeometry y="20" width="110" height="160" as="geometry" />
        </mxCell>
        <mxCell id="L_L-WssNXw5YL5tKDDHF-4" value="&lt;font color=&quot;#0000ff&quot;&gt;вроде логично , пусть так&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="3090" y="2210" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L_L-WssNXw5YL5tKDDHF-5" value="&lt;font color=&quot;#0000ff&quot;&gt;в ролевой - вроде Рук. ДЗ есть, но это слишком высокий уровень, посмотри по имеющимся РП и ЧТЗ - скорее это Руководитель подразделения по экспертизе&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;за последние годы уровень принятия решений значительно снизился&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;(ждем, когда разрешат общаться с функциональными заказчиками напрямую)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2281" y="2270" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="L_L-WssNXw5YL5tKDDHF-6" value="&lt;font color=&quot;#0000ff&quot;&gt;документы отличаются, т.к. у них разная степень актуальности (причем оба не актуальны),&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;по возможности - делаем максимально логично и просто&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;тот, кто делал предыдущие документы - не идеален, Заказчик тоже меняет хотелки&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="940" y="3300" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="5nkfMSBrBw4HWF1DkEKx-1" value="&lt;font color=&quot;#0000ff&quot;&gt;опечатка - сначала ИЭЗ (индивидуальные экспертные заключения,&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;а потом СЭЗ (Сводное эксп. заключение)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="2630" y="3809" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5nkfMSBrBw4HWF1DkEKx-2" value="&lt;font color=&quot;#0000ff&quot;&gt;лучше дописать &quot;Замена эксперта &lt;u&gt;в ЭГ после объявления закупки&lt;/u&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;(потому что в Activity: Формирование экспертной группы&quot; тоже возможна замена эксперта&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="5750" y="3000" width="600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5nkfMSBrBw4HWF1DkEKx-3" value="&lt;font color=&quot;#0000ff&quot;&gt;уточнить - здесь наверное Секретарь ЗК / Куратор ЭГ&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" vertex="1" parent="1">
          <mxGeometry x="5700" y="3859" width="340" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
