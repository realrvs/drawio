  <diagram id="WI7ZxxDH0FYdo8lrjFzc" name="2.24.Жалобы">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n&#39; Entities\nentity users {\n  + id : INT\n  --\n  name : VARCHAR\n}\n\nentity purchases {\n  + id : INT\n  --\n  name : VARCHAR\n}\n\nentity complaints {\n  + id : INT\n  eis_number : VARCHAR(50)\n  receipt_date : DATE\n  reason_code : VARCHAR(20)\n  reason_description : TEXT\n  author_id : INT\n  responsible_id : INT\n  purchase_id : INT\n  status_code : VARCHAR(20)\n  registration_status : BOOLEAN\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity complaint_files {\n  + id : INT\n  complaint_id : INT\n  file_name : VARCHAR(255)\n  file_path : VARCHAR(512)\n  file_size : BIGINT\n  version : INT\n  status : VARCHAR(20)\n  uploaded_at : TIMESTAMP\n  uploaded_by : INT\n}\n\nentity complaint_notes {\n  + id : INT\n  complaint_id : INT\n  note_text : TEXT\n  author_id : INT\n  created_at : TIMESTAMP\n  is_visible : BOOLEAN\n}\n\nentity complaint_objections {\n  + id : INT\n  complaint_id : INT\n  objection_type : VARCHAR(50)\n  file_name : VARCHAR(255)\n  file_path : VARCHAR(512)\n  file_size : BIGINT\n  comment : TEXT\n  uploaded_at : TIMESTAMP\n  uploaded_by : INT\n}\n\nentity complaint_decisions {\n  + id : INT\n  complaint_id : INT\n  decision_date : DATE\n  decision_result : VARCHAR(20)\n  decision_text : TEXT\n  justification : TEXT\n  registration_status : BOOLEAN\n  registered_at : TIMESTAMP\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity decision_files {\n  + id : INT\n  decision_id : INT\n  file_name : VARCHAR(255)\n  file_path : VARCHAR(512)\n  file_size : BIGINT\n  version : INT\n  status : VARCHAR(20)\n  uploaded_at : TIMESTAMP\n  uploaded_by : INT\n}\n\n&#39; Relationships\nusers ||--o{ complaints           : \&quot;author\&quot;\nusers ||--o{ complaints           : \&quot;responsible\&quot;\npurchases ||--o{ complaints       : \&quot;purchase\&quot;\ncomplaints ||--o{ complaint_files  : \&quot;files\&quot;\ncomplaints ||--o{ complaint_notes  : \&quot;notes\&quot;\ncomplaints ||--o{ complaint_objections : \&quot;objections\&quot;\ncomplaints ||--o{ complaint_decisions  : \&quot;decisions\&quot;\ncomplaint_decisions ||--o{ decision_files : \&quot;files\&quot;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="ckvgt4Ou2ML6ouKTwsou-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-750" y="-100" width="924" height="925" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n[*] --&gt; NoDecision : \&quot;Регистрация жалобы\&quot;\n\nstate \&quot;Нет решения\&quot; as NoDecision {\n}\n\nstate \&quot;На рассмотрении\&quot; as UnderReview {\n}\n\nstate \&quot;Принято решение\&quot; as Decided {\n}\n\nNoDecision --&gt; UnderReview : Начать рассмотрение\nUnderReview --&gt; Decided : Сохранить решение\n\nstate \&quot;Поступило\\nна согласование\&quot; as PendingApproval {\n}\n\nstate \&quot;Поступило\\nна доработку\&quot; as NeedRevision {\n}\n\nstate \&quot;Зарегистрировано\&quot; as Registered {\n}\n\nPendingApproval --&gt; Registered : Зарегистрировать\nPendingApproval --&gt; NeedRevision : Отправить на доработку\nNeedRevision --&gt; PendingApproval : Сохранить доработку\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="ckvgt4Ou2ML6ouKTwsou-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="330" y="-80" width="664" height="438" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ckvgt4Ou2ML6ouKTwsou-3" value="Статусная модель" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="605" y="-152" width="130" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|User|\nstart\n:Открыть модуль «Жалобы»;\n:Выбрать действие;\nif (Действие?) then (Создать жалобу)\n  :Ввести данные жалобы;\n  :Валидировать поля;\n  :Сохранить жалобу (статус «На рассмотрении»);\n  :Уведомить ответственного;\n  :Прикрепить файлы;\n  note right\n    Старые версии\n    архивируются\n  end note\nelseif (Редактировать жалобу)\n  :Загрузить данные жалобы;\n  :Внести правки;\n  :Валидировать поля;\n  :Сохранить изменения;\n  :Уведомить об изменениях;\nelseif (Применить фильтр)\n  :Показать панель фильтра;\n  :Задать критерии поиска;\n  :Валидировать даты;\n  :Обновить список жалоб;\nelseif (Просмотреть жалобу)\n  :Открыть карточку жалобы;\n  :Загрузить общие сведения;\n  :Загрузить закупку, лоты, заказчика, организатора;\n  :Загрузить файлы и историю событий;\nelseif (Управлять файлами)\n  :Перейти на вкладку «Файлы»;\n  fork\n    :Добавить файл;\n    :Валидировать формат/размер;\n    :Версионировать;\n  fork again\n    :Скачать все одним архивом;\n  end fork\nelseif (Добавить примечание)\n  :Открыть форму примечания;\n  :Ввести текст;\n  :Валидировать не пусто;\n  :Сохранить примечание;\nelseif (Экспорт в Excel)\n  :Нажать «Экспорт»;\n  :Собрать данные с учётом фильтров;\n  :Сгенерировать XLSX;\n  :Скачать файл;\nelseif (Создать решение)\n  :Открыть форму решения;\n  :Ввести дату, результат, текст, обоснование;\n  :Валидировать поля;\n  :Сохранить решение;\n  :Поменять статус жалобы на «Принято решение»;\nelseif (Редактировать решение)\n  :Загрузить данные решения;\n  :Внести правки;\n  :Валидировать поля;\n  :Сохранить изменения;\nelseif (Просмотреть решение)\n  :Открыть карточку решения;\n  :Загрузить все поля и вложения;\nelseif (Регистрация решения)\n  :Нажать «Зарегистрировать»/«Отменить регистрацию»;\n  :Обновить статус регистрации;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="ckvgt4Ou2ML6ouKTwsou-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1260" y="-180" width="2827" height="590" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ckvgt4Ou2ML6ouKTwsou-5" value="Диграмма активити процессов" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2635" y="-262" width="190" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor Пользователь as User\n\npackage \&quot;Модуль работы с жалобами\&quot; {\n  usecase \&quot;Создание новой жалобы\&quot; as UC01\n  usecase \&quot;Редактирование жалобы\&quot;      as UC02\n  usecase \&quot;Применение фильтров\&quot;        as UC03\n  usecase \&quot;Просмотр карточки жалобы\&quot;   as UC05\n  usecase \&quot;Управление файлами жалобы\&quot;  as UC06\n  usecase \&quot;Добавление примечания\&quot;      as UC07\n  usecase \&quot;Экспорт жалоб в Excel\&quot;      as UC09\n  usecase \&quot;Создание решения\&quot;           as UD01\n  usecase \&quot;Редактирование решения\&quot;     as UD02\n  usecase \&quot;Просмотр решения\&quot;           as UD03\n  usecase \&quot;Регистрация решения\&quot;        as UD05\n}\n\nUser --&gt; UC01\nUser --&gt; UC02\nUser --&gt; UC03\nUser --&gt; UC05\nUser --&gt; UC06\nUser --&gt; UC07\nUser --&gt; UC09\nUser --&gt; UD01\nUser --&gt; UD02\nUser --&gt; UD03\nUser --&gt; UD05\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="ckvgt4Ou2ML6ouKTwsou-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="1090" y="510" width="379" height="860" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
