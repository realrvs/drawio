        </mxCell>
        <mxCell id="uk9AKWKX_hUPzYHT_5Rm-0" value="Нужна связка: &#xa;1. Контейнер - Вопрос, по кнопке &quot;Сформировать вопрос на ЦЗК&quot; из реестра контейнера &#xa;2. Вопрос - Обращение в ЦЗК,  по кнопке &quot;Отправить для включения в обращение&quot; из реестра вопросов &#xa;3. Обращение в ЦЗК - Проект протоколов ЦЗК, по кнопке &quot;Отправить для включения в проект протокола&quot; из реестра обращений в ЦЗК &#xa;4. Проект протоколов ЦЗК - кнопка &quot;Расчет кворума&quot; и &quot;Проставить голоса&quot; - открывается экранная форма «Голосование ЦЗК» по кнопке &quot;Завершить голосование и создать итоговый протокол» будет сформирован итоговый протокол ЦЗК и осуществлен переход к реестру «Протоколы ЦЗК»" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="HaY8drDbm0udXo7mg0b6-1">
          <mxGeometry x="20" y="280" width="230" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="H3bZG-SrOB5-mya8uvQB" name="ЦЗК Рис 1">
    <mxGraphModel dx="1426" dy="785" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\n&lt;style&gt;\n diamond {\n    BackgroundColor #00000\n  }\n&lt;/style&gt;\n\nstart\n\n#ffffff:Пользователь инициирует вопрос на ЦЗК;\nif (Создание через контейнер / жалобу / договор?) then (Да)\n#ffffff  :Формируется объект \&quot;Вопрос\&quot;;\nelse\n#ffffff  :Создание вручную через \&quot;Добавить\&quot;;\n#ffffff  :Заполнение полей формы \&quot;Вопрос\&quot;;\nendif\n\n#ffffff:Отправка вопроса для включения в Обращение;\n#ffffff:Создание Обращения в ЦЗК;\n#ffffff:Выбор актуальных вопросов;\n\nrepeat\n#ffffff:Заполнение вкладок: \&quot;Основные данные\&quot;, \&quot;Вопросы\&quot;, \&quot;Текст обращения\&quot;;\n\nrepeat while (Все данные заполнены?) is (Нет) not (Да)\n#ffffff  :Сохранение Обращения;\n\n\n\n#ffffff:Инициирование согласования Обращения;\n#ffffff:Согласование Обращения;\n\n#ffffff:Создание проекта протокола ЦЗК;\n#ffffff:Создание бюллетеней для голосования;\n#ffffff:Запуск голосования;\nrepeat\n#ffffff  :Голосование членами ЦЗК;\nrepeat while (Все проголосовали?) is (Нет)\n\n#ffffff:Расчет кворума;\nif (Кворум достигнут?) then (Да)\n#ffffff  :Создание итогового протокола;\n#ffffff  :Подписание итогового протокола;\n  stop\nelse\n#ffffff  :Возврат на доработку или приостановка;\n  stop\nendif\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="VGqXjmKM0SXqRH6wWgiZ-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="130" y="130" width="508" height="1267" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
