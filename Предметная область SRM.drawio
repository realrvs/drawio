        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle State: Индивидуальное экспертное заключение (ИЭЗ)\nskinparam linetype ortho\n\n[*] --&gt; В_работе\n\nВ_работе --&gt; На_проверке : Отправить на проверку\nНа_проверке --&gt; На_доработке : Отклонить куратором\nНа_доработке --&gt; На_проверке : Повторно отправить\nНа_проверке --&gt; Проверено : Подтвердить куратором\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="APpgim2DJLIOlVZ5rh97-2">
