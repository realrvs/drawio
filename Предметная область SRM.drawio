        <mxCell id="L-7PZKD7Y2jL_qXZ3S3v-12" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); background-color: transparent;&quot;&gt;&lt;u&gt;Вопрос Заказчику:&lt;/u&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;в РП не описан процесс согласования Заявки - просьба дать информацию.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;Судя по файлу &quot;Сапозамещение&quot;, Заявка либо&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;а)&lt;/b&gt; автоматически становится &quot;согласованной&quot; (и доступна для включения в Лот),&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;б) &lt;/b&gt;либо (по каком принципу?) отправляется по цепочке согласования в РГС и именно там может быть либо &quot;согласована&quot;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#ff0000&quot;&gt;&lt;b&gt;в) &lt;/b&gt;либо сотрудником РГС включена в Сводную Заявку и после этого &quot;согласована&quot;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1675" y="897.5" width="240" height="125" as="geometry" />
        </mxCell>
