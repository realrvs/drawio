        <mxCell id="izdXQZAGnsvKLJ6Wg3wu-181" value="Диаграмма классов" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=32;fontStyle=1" parent="1" vertex="1">
