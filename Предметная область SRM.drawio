        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Фильтрация реестра КЦД\n\n|Пользователь|\nstart\n:Нажать «Показать фильтр»;\n\n|Система|\n:Развернуть панель фильтра с полями;\n\n|Пользователь|\n:Задать значения в полях (текст, выпадающие списки, диапазоны, справочники);\n\n|Пользователь|\n:Нажать «Применить»;\n\n|Система|\n:Выполнить фильтрацию по заданным условиям;\n:Обновить таблицу реестра;\n\n|Пользователь|\n:Просмотреть отфильтрованные записи;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-1640" y="1070" width="786" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Выбор контрагента из справочника\n\n|Пользователь|\nstart\n:Нажать «...» рядом с полем «Контрагент»;\n\n|Система|\n:Открыть модальное окно «Выбор значения: Контрагент»;\n\n|Пользователь|\n:Искать контрагента (ввод текста или прокрутка);\n:Выбрать строку;\n:Нажать «ОК»;\n\n|Система|\n:Закрыть окно;\n:Заполнить поле «Контрагент» выбранной записью;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-8">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-2490" y="1090" width="678" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Выбор способа закупки из справочника\n\n|Пользователь|\nstart\n:Нажать «...» рядом с полем «Способ закупки»;\n\n|Система|\n:Открыть модальное окно «Выбор значения: Способ закупки»;\n\n|Пользователь|\n:Прокручивать список или вводить текст для поиска;\n:Выбрать нужную строку;\n:Нажать «ОК»;\n\n|Система|\n:Закрыть окно;\n:Заполнить поле «Способ закупки» выбранной записью;\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-9">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-3340" y="1120" width="714" height="515" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\n\nentity \&quot;statuses\\n(Статусы КЦД)\&quot; as STAT {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  name : VARCHAR(100&gt;\n}\n\nentity \&quot;contractors\\n(Контрагенты)\&quot; as C {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  full_name : VARCHAR(255&gt;\n  short_name : VARCHAR(150&gt;\n  inn : CHAR(10&gt;\n  kpp : CHAR(9&gt;\n  ogrn : CHAR(13&gt;\n}\n\nentity \&quot;procurement_methods\\n(Способы закупки)\&quot; as PM {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  name : VARCHAR(200&gt;\n  start_date : DATE\n  end_date : DATE\n  form : VARCHAR(50&gt;\n}\n\nentity \&quot;lots\\n(Лоты)\&quot; as L {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  lot_number : VARCHAR(50&gt;\n  subject : VARCHAR(255&gt;\n  year : SMALLINT\n  planned_price_with_vat : DECIMAL(18,2&gt;\n  procurement_method_id : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;kcd_registry\\n(Реестр КЦД)\&quot; as K {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  contractor_id : INT &lt;&lt;FK&gt;&gt;\n  lot_id : INT &lt;&lt;FK&gt;&gt;\n  customer : VARCHAR(255&gt;\n  contract_number : VARCHAR(50&gt;\n  contract_date : DATE\n  contract_price_with_vat : DECIMAL(18,2&gt;\n  upload_date : DATETIME\n  update_date : DATETIME\n  status_id : INT &lt;&lt;FK&gt;&gt;\n}\n\nentity \&quot;kcd_files\\n(Файлы КЦД)\&quot; as KF {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  kcd_id : INT &lt;&lt;FK&gt;&gt;\n  file_name : VARCHAR(255&gt;\n  file_path : VARCHAR(500&gt;\n}\n\nentity \&quot;kcd_approval_log\\n(Журнал согласования)\&quot; as KL {\n  * id : INT &lt;&lt;PK&gt;&gt;\n  --\n  kcd_id : INT &lt;&lt;FK&gt;&gt;\n  user_id : INT\n  action_date : DATETIME\n  status_id : INT &lt;&lt;FK&gt;&gt;\n  approval_flag : BOOLEAN\n  comment : TEXT\n}\n\nC ||--o{ K : contractor_id\nL ||--o{ K : lot_id\nSTAT ||--o{ K : status_id\nPM ||--o{ L : procurement_method_id\nK ||--o{ KF : kcd_id\nK ||--o{ KL : kcd_id\nSTAT ||--o{ KL : status_id\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rSTS5pRBodv4w890v1ij-10">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" parent="1" vertex="1">
            <mxGeometry x="-2520" y="150" width="700" height="837" as="geometry" />
          </mxCell>
        </UserObject>
