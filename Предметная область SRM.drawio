  <diagram id="EZztcQjWzvMLJREKh-2O" name="Жалобы Рис 1">
    <mxGraphModel dx="1426" dy="785" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n|User|\nstart\n:Открыть модуль «Жалобы»;\n:Выбрать действие;\nif (Действие?) then (Создать жалобу)\n  :Ввести данные жалобы;\n  :Валидировать поля;\n  :Сохранить жалобу (статус «На рассмотрении»);\n  :Уведомить ответственного;\n  :Прикрепить файлы;\n  note right\n    Старые версии\n    архивируются\n  end note\nelseif (Редактировать жалобу)\n  :Загрузить данные жалобы;\n  :Внести правки;\n  :Валидировать поля;\n  :Сохранить изменения;\n  :Уведомить об изменениях;\nelseif (Применить фильтр)\n  :Показать панель фильтра;\n  :Задать критерии поиска;\n  :Валидировать даты;\n  :Обновить список жалоб;\nelseif (Просмотреть жалобу)\n  :Открыть карточку жалобы;\n  :Загрузить общие сведения;\n  :Загрузить закупку, лоты, заказчика, организатора;\n  :Загрузить файлы и историю событий;\nelseif (Управлять файлами)\n  :Перейти на вкладку «Файлы»;\n  fork\n    :Добавить файл;\n    :Валидировать формат/размер;\n    :Версионировать;\n  fork again\n    :Скачать все одним архивом;\n  end fork\nelseif (Добавить примечание)\n  :Открыть форму примечания;\n  :Ввести текст;\n  :Валидировать не пусто;\n  :Сохранить примечание;\nelseif (Экспорт в Excel)\n  :Нажать «Экспорт»;\n  :Собрать данные с учётом фильтров;\n  :Сгенерировать XLSX;\n  :Скачать файл;\nelseif (Создать решение)\n  :Открыть форму решения;\n  :Ввести дату, результат, текст, обоснование;\n  :Валидировать поля;\n  :Сохранить решение;\n  :Поменять статус жалобы на «Принято решение»;\nelseif (Редактировать решение)\n  :Загрузить данные решения;\n  :Внести правки;\n  :Валидировать поля;\n  :Сохранить изменения;\nelseif (Просмотреть решение)\n  :Открыть карточку решения;\n  :Загрузить все поля и вложения;\nelseif (Регистрация решения)\n  :Нажать «Зарегистрировать»/«Отменить регистрацию»;\n  :Обновить статус регистрации;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="CbW2QzHgFFQqvB1z6fg1-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="40" y="50" width="2827" height="590" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
