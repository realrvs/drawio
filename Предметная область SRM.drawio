        <mxCell id="PqC6RhTS1gyLuVYjz_Tp-3" value="Диаграммы USER CASE" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=20;" parent="1" vertex="1">
          <mxGeometry x="17" y="-47" width="246" height="36" as="geometry" />
